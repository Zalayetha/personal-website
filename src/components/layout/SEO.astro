---
import {
    SITE_URL,
    SITE_NAME,
    SITE_TITLE,
    DEFAULT_DESCRIPTION,
    DEFAULT_OG_IMAGE,
} from "../../utils/seo";

export interface BreadcrumbItem {
    name: string;
    path: string;
}

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
    author?: string;
    canonical?: string;
    noindex?: boolean;
    breadcrumbs?: BreadcrumbItem[];
    schema?: Record<string, any> | Record<string, any>[];
}

const siteUrl = (Astro.site ? Astro.site.origin : SITE_URL).replace(/\/$/, "");

const {
    title = SITE_TITLE,
    description = DEFAULT_DESCRIPTION,
    image = DEFAULT_OG_IMAGE,
    type = "website",
    publishedTime,
    modifiedTime,
    tags = [],
    author = SITE_NAME,
    canonical,
    noindex = false,
    breadcrumbs,
    schema,
} = Astro.props;

// Determine clean canonical URL
const cleanPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = canonical
    ? new URL(canonical, siteUrl).toString()
    : new URL(cleanPathname, siteUrl).toString();

const imageURL = new URL(image, siteUrl).toString();
const rssURL = new URL("/rss.xml", siteUrl).toString();
const sitemapURL = new URL("/sitemap.xml", siteUrl).toString();

// Build JSON-LD structured data graph
const personSchema = {
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: "Zaghy Zalayetha",
    alternateName: "Mohammad Zaghy Zalayetha Sofjan",
    jobTitle: "Software Engineer",
    worksFor: {
        "@type": "Organization",
        name: "C3ARBON",
    },
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Universitas Budi Luhur",
    },
    address: {
        "@type": "PostalAddress",
        addressLocality: "Tangerang City",
        addressRegion: "Banten",
        addressCountry: "ID",
    },
    url: siteUrl,
    sameAs: [
        "https://www.linkedin.com/in/mohammad-zaghy-zalayetha-sofjan/",
        "https://github.com/Zalayetha",
    ],
    knowsAbout: [
        "Software Engineering",
        "Full Stack Web Development",
        "Mobile App Development",
        "React",
        "React Native",
        "TypeScript",
        "Node.js",
        "Flutter",
        "AI Integrations",
    ],
};

const webSiteSchema = {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "Zaghy Zalayetha",
    alternateName: ["Zaghy", "zaghy.my.id"],
    description: DEFAULT_DESCRIPTION,
    publisher: {
        "@id": `${siteUrl}/#person`,
    },
    inLanguage: "en-US",
};

const graph: Record<string, any>[] = [personSchema, webSiteSchema];

if (breadcrumbs && breadcrumbs.length > 0) {
    graph.push({
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: crumb.name,
            item: new URL(crumb.path, siteUrl).toString(),
        })),
    });
}

if (schema) {
    if (Array.isArray(schema)) {
        graph.push(...schema);
    } else {
        graph.push(schema);
    }
}

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": graph,
};
---

<!-- Canonical & Discovery -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} » Feed`} href={rssURL} />
<link rel="sitemap" type="application/xml" href={sitemapURL} />

<!-- General Search Engine Directives -->
<meta name="author" content={author} />
<meta name="theme-color" content="#008752" />
{
    noindex ? (
        <meta name="robots" content="noindex, follow" />
    ) : (
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
    )
}
{
    noindex ? (
        <meta name="googlebot" content="noindex, follow" />
    ) : (
        <meta
            name="googlebot"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
    )
}

<!-- Open Graph / Facebook / LinkedIn / Discord / WhatsApp -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
)}
{type === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
)}
{type === "article" && (
    <meta property="article:author" content={`${siteUrl}/#person`} />
)}
{type === "article" && (
    <meta property="article:section" content="Software Engineering" />
)}
{type === "article" && tags.map((tag) => (
    <meta property="article:tag" content={tag} />
))}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
