---
const pathname = Astro.url.pathname;

const navItems = [
    { href: "/work", label: "Work", aliases: ["/projects"] },
    { href: "/writing", label: "Writing", aliases: ["/blog"] },
    { href: "/about", label: "About", aliases: [] },
];

function isCurrent(item: typeof navItems[0]) {
    if (pathname === item.href) return true;
    if (item.aliases.some((alias) => pathname.startsWith(alias))) return true;
    if (item.href !== "/" && pathname.startsWith(item.href)) return true;
    return false;
}
---

<header class="w-full">
    <div class="page-shell">
        <div class="flex items-center justify-between min-h-[96px] sm:min-h-[104px]">
            <a
                href="/"
                class="inline-flex items-center text-[19px] font-medium tracking-[-0.065em] text-[#151614] hover:opacity-80 transition-opacity"
            >
                zaghy<span class="text-[#676a62]">.</span>
            </a>

            <nav class="flex items-center gap-6 sm:gap-8 text-xs font-normal">
                {
                    navItems.map((item) => {
                        const active = isCurrent(item);
                        return (
                            <a
                                href={item.href}
                                aria-current={active ? "page" : undefined}
                                class:list={[
                                    "min-h-[44px] inline-flex items-center transition-colors",
                                    active
                                        ? "text-[#151614] underline underline-offset-[6px] decoration-1 decoration-[#151614]"
                                        : "text-[#676a62] hover:text-[#151614]",
                                ]}
                            >
                                {item.label}
                            </a>
                        );
                    })
                }
            </nav>
        </div>
    </div>
</header>
