---
import { contact } from "../../data/portfolio";

const pathname = Astro.url.pathname;

const navItems = [
    { href: "/work", label: "Work", aliases: ["/projects"] },
    { href: "/writing", label: "Writing", aliases: ["/blog"] },
    { href: "/services", label: "Services", aliases: [] },
    { href: "/about", label: "About", aliases: [] },
];

function isCurrent(item: typeof navItems[0]) {
    if (pathname === item.href) return true;
    if (item.aliases.some((alias) => pathname.startsWith(alias))) return true;
    if (item.href !== "/" && pathname.startsWith(item.href)) return true;
    return false;
}
---

<header class="w-full border-b border-[#e2e8f0]/80 bg-white/80 backdrop-blur-xs sticky top-0 z-40">
    <div class="page-shell">
        <div class="flex items-center justify-between min-h-[84px] sm:min-h-[96px]">
            <a
                href="/"
                class="inline-flex items-center text-[19px] font-semibold tracking-[-0.065em] text-[#0f172a] hover:opacity-85 transition-opacity"
            >
                zaghy<span class="text-[#008752]">.</span>
            </a>

            <nav class="flex items-center gap-3.5 sm:gap-8 text-xs font-normal">
                {
                    navItems.map((item) => {
                        const active = isCurrent(item);
                        return (
                            <a
                                href={item.href}
                                aria-current={active ? "page" : undefined}
                                class:list={[
                                    "min-h-[44px] inline-flex items-center transition-colors font-medium",
                                    active
                                        ? "text-[#008752] underline underline-offset-[6px] decoration-1 decoration-[#008752]"
                                        : "text-[#64748b] hover:text-[#008752]",
                                ]}
                            >
                                {item.label}
                            </a>
                        );
                    })
                }
                <a
                    href={`mailto:${contact.email}`}
                    class="inline-flex items-center px-3 sm:px-4 py-2 rounded-full bg-[#008752] text-white text-[11px] sm:text-xs font-medium hover:bg-[#007346] transition-colors shadow-xs whitespace-nowrap"
                >
                    <span class="sm:hidden">Hire me</span>
                    <span class="hidden sm:inline">Work with me</span>
                </a>
            </nav>
        </div>
    </div>
</header>
