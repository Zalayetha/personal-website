---
const displayExperience = [
    { company: "C3ARBON", role: "Full-Stack Engineer", period: "2026–now" },
    { company: "Universitas Budi Luhur", role: "Staff Programmer", period: "2023–2026" },
    { company: "Bangkit Academy", role: "Mobile Developer Cohort", period: "2024" },
    { company: "English Space", role: "Web Developer", period: "2022–2023" },
];
---

<section class="w-full py-12 sm:py-16" aria-labelledby="background-title">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20">
        <div>
            <h2 id="background-title" class="text-[26px] sm:text-[28px] font-normal tracking-[-0.045em] leading-[1.3] text-[#151614] m-0">
                Always building.<br />
                <span class="text-[#888985]">Always learning.</span>
            </h2>
            <p class="max-w-[340px] text-[13px] text-[#676a62] my-5 leading-[1.8]">
                From cross-platform mobile apps to full-stack web platforms and applied AI systems. I like understanding how systems work under the hood, then engineering clean solutions with what I learn.
            </p>
            <a href="/about" class="text-link text-xs text-[#676a62] hover:text-[#151614] font-medium">
                <span>A little more about me</span>
                <span aria-hidden="true">↗</span>
            </a>
        </div>

        <div class="flex flex-col" aria-label="Recent experience">
            {
                displayExperience.map((item, index) => (
                    <div class:list={[
                        "flex items-baseline justify-between gap-4 py-4 border-b border-[#d1d3ca]",
                        index === 0 && "border-t md:border-t-0",
                        index === displayExperience.length - 1 && "border-b-0 pb-0",
                    ]}>
                        <div>
                            <h3 class="text-[14px] font-medium text-[#151614] m-0">
                                {item.company}
                            </h3>
                            <p class="text-[12px] text-[#676a62] mt-1 mb-0">
                                {item.role}
                            </p>
                        </div>
                        <span class="text-[#676a62] font-mono text-[10px] sm:text-[11px] flex-shrink-0">
                            {item.period}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>
