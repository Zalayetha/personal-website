---
import { contact } from "../../../data/portfolio";
import HeroFlow from "../../ui/HeroFlow.astro";
---

<section class="w-full pt-6 sm:pt-10">
    <HeroFlow class="rounded-3xl border border-[#e2e8f0]/80 p-6 sm:p-10 md:p-12 bg-white/60 shadow-xs">
        <div class="relative z-1 max-w-2xl">
            <h1 class="text-[clamp(40px,5.2vw,68px)] font-bold tracking-[-0.065em] text-[#0f172a] leading-[1.06]">
                Zaghy Zalayetha<span class="text-[#008752]">.</span>
            </h1>

            <p class="max-w-[480px] text-[#64748b] text-[16px] sm:text-[17px] leading-[1.85] mt-6">
                I help businesses and founders build software that solves real problems.
            </p>

            <p class="text-[#64748b] text-xs mt-4 font-mono">
                Based in Tangerang, Indonesia. Building everywhere.
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3 sm:gap-4">
                <a
                    href={`mailto:${contact.email}`}
                    class="group inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#008752] text-white text-xs sm:text-sm font-medium hover:bg-[#007346] transition-colors shadow-xs"
                >
                    <span>Let's talk</span>
                    <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                </a>
                <a
                    href="/work"
                    class="group inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white/90 text-[#0f172a] border border-[#e2e8f0] text-xs sm:text-sm font-medium hover:bg-white hover:border-[#cbd5e1] transition-colors"
                >
                    <span>View work</span>
                    <span class="text-[#008752] text-xs transition-transform group-hover:translate-x-0.5">→</span>
                </a>
                <a
                    href="/about"
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white/90 text-[#0f172a] border border-[#e2e8f0] text-xs sm:text-sm font-medium hover:bg-white transition-colors"
                >
                    <span>About me</span>
                </a>
            </div>
        </div>
    </HeroFlow>

    <!-- Hero Bottom Status Line -->
    <div class="border-b border-[#e2e8f0] flex flex-wrap items-end justify-between gap-6 sm:gap-10 pt-10 sm:pt-14 pb-10 sm:pb-12 text-xs">
        <div>
            <span class="eyebrow block mb-1 text-[9px] text-[#64748b]">Currently</span>
            <p class="m-0 text-[#0f172a] font-medium">
                Software Engineer <span class="text-[#64748b] font-normal">at C3ARBON</span>
            </p>
        </div>

        <div class="w-full sm:w-auto sm:ml-auto">
            <a
                href="#selected-work"
                class="text-link text-[11px] text-[#64748b] hover:text-[#008752] transition-colors"
            >
                <span>A few things I've built</span>
                <span aria-hidden="true" class="text-[#008752]">↓</span>
            </a>
        </div>
    </div>
</section>
