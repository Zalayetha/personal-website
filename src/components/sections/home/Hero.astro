---
import { contact } from "../../../data/portfolio";
---

<section class="w-full pt-8 sm:pt-14">
    <div class="grid grid-cols-1 md:grid-cols-[1.15fr_1fr] items-center gap-8 md:gap-12">
        <div class="relative z-1">
            <h1 class="text-[clamp(42px,5.5vw,70px)] font-bold tracking-[-0.065em] text-[#0f172a] leading-[1.06]">
                Zaghy Zalayetha<span class="text-[#008752]">.</span>
            </h1>

            <p class="max-w-[440px] text-[#64748b] text-[16px] sm:text-[17px] leading-[1.85] mt-6">
                I help businesses and founders build software that solves real problems.
            </p>

            <p class="text-[#64748b] text-xs mt-4 font-mono">
                Based in Tangerang, Indonesia. Building everywhere.
            </p>

            <div class="mt-7 flex items-center gap-4">
                <a
                    href={`mailto:${contact.email}`}
                    class="group inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#008752] text-white text-xs sm:text-sm font-medium hover:bg-[#007346] transition-colors shadow-xs"
                >
                    <span>Let's talk</span>
                    <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                </a>
                <a
                    href="/about"
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#f8fafc] text-[#0f172a] border border-[#e2e8f0] text-xs sm:text-sm font-medium hover:bg-[#f1f5f9] transition-colors"
                >
                    <span>About me</span>
                </a>
            </div>
        </div>

        <div class="flex justify-start md:justify-end">
            <div class="relative w-44 h-44 sm:w-56 sm:h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden border border-[#e2e8f0] bg-[#f8fafc] shadow-xs">
                <img
                    src="/assets/profile_picture.png"
                    alt="Zaghy Zalayetha"
                    class="w-full h-full object-cover grayscale contrast-[1.05] hover:grayscale-0 transition duration-500"
                    loading="eager"
                />
            </div>
        </div>
    </div>

    <!-- Hero Bottom Status Line -->
    <div class="border-b border-[#e2e8f0] flex flex-wrap items-end justify-between gap-6 sm:gap-10 pt-12 sm:pt-16 pb-10 sm:pb-12 mt-4 text-xs">
        <div>
            <span class="eyebrow block mb-1 text-[9px] text-[#64748b]">Currently</span>
            <p class="m-0 text-[#0f172a] font-medium">
                Full-Stack Engineer <span class="text-[#64748b] font-normal">at C3ARBON</span>
            </p>
        </div>

        <div class="w-full sm:w-auto sm:ml-auto">
            <a
                href="#selected-work"
                class="text-link text-[11px] text-[#64748b] hover:text-[#008752] transition-colors"
            >
                <span>A few things I've built</span>
                <span aria-hidden="true" class="text-[#008752]">↓</span>
            </a>
        </div>
    </div>
</section>
