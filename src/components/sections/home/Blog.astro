---
import Section from "../../layout/Section.astro";
import { blogPosts } from "../../../data/portfolio";

const latestPosts = blogPosts.slice(0, 3);
---

<Section id="blog">
    <div class="flex items-end justify-between">
        <div>
            <h2 class="font-newsreader text-3xl font-bold text-gray-950">
                Latest Posts
            </h2>
            <p class="font-manrope text-base text-gray-500 mt-3">
                Thoughts on building software and everything in between.
            </p>
        </div>
        <a
            href="/blog"
            class="font-manrope text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors hidden sm:flex items-center gap-1"
        >
            View all posts
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
    </div>

    <div class="grid lg:grid-cols-3 grid-cols-1 gap-4 mt-10">
        {
            latestPosts.map((post) => (
                <a
                    href={`/blog/${post.slug}`}
                    class="group block p-6 rounded-xl bg-white border border-gray-200 transition-all duration-300 hover:border-gray-300 hover:shadow-lg hover:shadow-gray-200/50"
                >
                    <div class="flex items-center gap-2 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span class="font-manrope text-sm text-gray-400">
                            {post.date}
                        </span>
                    </div>
                    <h3 class="font-newsreader text-lg font-semibold text-gray-950 mb-2 group-hover:text-gray-700 transition-colors line-clamp-2">
                        {post.title}
                    </h3>
                    <p class="font-manrope text-sm text-gray-500 leading-relaxed line-clamp-3">
                        {post.excerpt}
                    </p>
                    <div class="flex flex-wrap gap-2 mt-4">
                        {post.tags.slice(0, 3).map((tag) => (
                            <span class="font-manrope text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-500">
                                {tag}
                            </span>
                        ))}
                    </div>
                </a>
            ))
        }
    </div>

    <a
        href="/blog"
        class="font-manrope text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors sm:hidden flex items-center justify-center gap-1 mt-6"
    >
        View all posts
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
    </a>
</Section>
