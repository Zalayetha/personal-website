---
console.log("Contact Section Run 🏃");
import Section from "../../layout/Section.astro";
import { Ripple } from "../../magicui/ripple";
import { ShimmerButton } from "../../magicui/shimmer-button";
import { BlurFade } from "../../magicui/blur-fade";
import { contact } from "../../../data/portfolio";
---

<Section id="contact">
    <BlurFade client:visible delay={0.05}>
        <div class="relative overflow-hidden rounded-3xl border border-gray-200/80 bg-white/70 py-16 px-6 sm:px-12 text-center shadow-sm">
            <!-- Magic UI Ambient Ripple Effect -->
            <Ripple client:visible mainCircleSize={180} numCircles={6} mainCircleOpacity={0.18} />

            <div class="relative z-10 max-w-xl mx-auto">
                <h2 class="font-newsreader text-3xl sm:text-4xl font-bold text-gray-950 tracking-tight">
                    {contact.cta}
                </h2>
                <p class="font-manrope text-base text-gray-500 mt-3 max-w-md mx-auto">
                    {contact.tagline}
                </p>
                <div class="mt-8 flex justify-center">
                    <a href={`mailto:${contact.email}`} class="inline-block group">
                        <ShimmerButton
                            client:visible
                            shimmerColor="#ffffff"
                            shimmerDuration="3s"
                            borderRadius="0.75rem"
                            background="rgba(17, 24, 39, 1)"
                            className="font-manrope text-sm font-semibold px-8 py-3.5 shadow-md group-hover:shadow-lg transition-shadow"
                        >
                            <span class="flex items-center gap-2">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="w-4 h-4"
                                >
                                    <rect width="20" height="16" x="2" y="4" rx="2" />
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                </svg>
                                Get in Touch
                            </span>
                        </ShimmerButton>
                    </a>
                </div>
            </div>
        </div>
    </BlurFade>
</Section>
