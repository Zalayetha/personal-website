---
console.log("Projects Section Run 🏃");
import Section from "../layout/Section.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import { BlurFade } from "../magicui/blur-fade";
import { projects } from "../../data/portfolio";
---

<Section id="projects">
    <BlurFade client:visible delay={0.05}>
        <div>
            <h2 class="font-newsreader text-3xl font-bold text-gray-950">
                Projects
            </h2>
            <p class="font-manrope text-base text-gray-500 mt-3">
                A collection of things I've built and shipped.
            </p>
        </div>
    </BlurFade>

    <div class="grid lg:grid-cols-2 grid-cols-1 gap-4 mt-10">
        {
            projects.map((project, idx) => (
                <BlurFade client:visible delay={0.1 + idx * 0.08}>
                    <ProjectCard
                        title={project.title}
                        description={project.tagline}
                        image={project.image}
                        href={`/projects/${project.slug}`}
                        linkText="View Project"
                    />
                </BlurFade>
            ))
        }
    </div>
</Section>
