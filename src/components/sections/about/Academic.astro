---
console.log("Academic Section Run 🏃");
import Section from "../../layout/Section.astro";
import EducationItem from "../../ui/EducationItem.astro";
import PublicationCard from "../../ui/PublicationCard.astro";
import SkillBadge from "../../ui/SkillBadge.astro";
import { BlurFade } from "../../magicui/blur-fade";
import {
    education,
    certifications,
    publication,
} from "../../../data/portfolio";
---

<Section id="academic">
    <BlurFade client:visible delay={0.05}>
        <div class="max-w-2xl">
            <h2 class="font-newsreader text-3xl font-bold text-gray-950">
                Academic
            </h2>
            <p class="font-manrope text-base text-gray-500 mt-3">
                Education, certifications, and publications.
            </p>
        </div>
    </BlurFade>

    <div class="mt-10 space-y-12">
        <BlurFade client:visible delay={0.12}>
            <div>
                <h3
                    class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-6"
                >
                    Education
                </h3>
                <div class="relative border-l border-gray-200 ml-1.5 space-y-8">
                    {
                        education.map((edu) => (
                            <EducationItem education={edu} />
                        ))
                    }
                </div>
            </div>
        </BlurFade>

        <BlurFade client:visible delay={0.2}>
            <div>
                <h3
                    class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-4"
                >
                    Certifications
                </h3>
                <div class="flex flex-wrap gap-2">
                    {
                        certifications.map((cert) => (
                            <SkillBadge
                                name={`${cert.name} – ${cert.issuer}`}
                                variant="light"
                            />
                        ))
                    }
                </div>
            </div>
        </BlurFade>

        <BlurFade client:visible delay={0.28}>
            <div>
                <h3
                    class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-4"
                >
                    Publication
                </h3>
                <PublicationCard publication={publication} />
            </div>
        </BlurFade>
    </div>
</Section>
