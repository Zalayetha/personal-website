---
console.log("Experience Section Run 🏃");
import Section from "../../layout/Section.astro";
import SectionDivider from "../../ui/SectionDivider.astro";
import ExperienceItem from "../../ui/ExperienceItem.astro";
import { experience } from "../../../data/portfolio";
---

<Section id="experience">
    <div class="max-w">
        <div class="font-newsreader text-3xl font-bold text-gray-950">
            Experience
        </div>
        <p class="font-manrope text-base text-gray-500 mt-3">
            My professional journey so far.
        </p>
    </div>

    <div class="mt-10 space-y-6">
        {
            experience.map((exp, index) => (
                <div>
                    <ExperienceItem experience={exp} />
                    {index < experience.length - 1 && (
                        <SectionDivider class="my-6" />
                    )}
                </div>
            ))
        }
    </div>
</Section>
