---
console.log("Experience Section Run 🏃");
import Section from "../../layout/Section.astro";
import ExperienceItem from "../../ui/ExperienceItem.astro";
import { BlurFade } from "../../magicui/blur-fade";
import { experience } from "../../../data/portfolio";
---

<Section id="experience">
    <BlurFade client:visible delay={0.05}>
        <div class="max-w">
            <h2 class="font-newsreader text-3xl font-bold text-gray-950">
                Experience
            </h2>
            <p class="font-manrope text-base text-gray-500 mt-3">
                My professional journey so far.
            </p>
        </div>
    </BlurFade>

    <div class="relative mt-10 border-l border-gray-200 ml-1.5 space-y-8">
        {
            experience.map((exp, index) => (
                <BlurFade client:visible delay={0.1 + index * 0.08}>
                    <ExperienceItem experience={exp} />
                </BlurFade>
            ))
        }
    </div>
</Section>
