---
console.log("Skills Section Run 🏃");
import Section from "../layout/Section.astro";
import SkillBadge from "../ui/SkillBadge.astro";
import { Marquee } from "../magicui/marquee";
import { BlurFade } from "../magicui/blur-fade";
import { hardSkills, softSkills } from "../../data/portfolio";
---

<Section id="skills">
    <BlurFade client:visible delay={0.05}>
        <div class="max-w-2xl">
            <h2 class="font-newsreader text-3xl font-bold text-gray-950">Skills</h2>
            <p class="font-manrope text-base text-gray-500 mt-3">
                Skills I've developed over the years.
            </p>
        </div>
    </BlurFade>

    <!-- Magic UI Infinite Marquee of Core Skills -->
    <BlurFade client:visible delay={0.1}>
        <div class="relative mt-8 py-3 overflow-hidden rounded-2xl border border-gray-200/80 bg-white/50 [mask-image:linear-gradient(to_right,transparent,white_10%,white_90%,transparent)]">
            <Marquee client:visible pauseOnHover repeat={4} className="[--duration:25s]">
                {
                    hardSkills.map((skill) => (
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-lg bg-white border border-gray-200 text-xs font-semibold font-manrope text-gray-800 shadow-2xs whitespace-nowrap">
                            {skill.name}
                        </span>
                    ))
                }
            </Marquee>
        </div>
    </BlurFade>

    <div class="mt-10 grid md:grid-cols-2 gap-6">
        <BlurFade client:visible delay={0.15}>
            <div class="p-6 rounded-2xl bg-white border border-gray-200/80 shadow-xs h-full">
                <h3
                    class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-4"
                >
                    Technical
                </h3>
                <div class="flex flex-wrap gap-2">
                    {
                        hardSkills.map((skill) => (
                            <SkillBadge name={skill.name} variant={skill.variant} />
                        ))
                    }
                </div>
            </div>
        </BlurFade>

        <BlurFade client:visible delay={0.22}>
            <div class="p-6 rounded-2xl bg-white border border-gray-200/80 shadow-xs h-full">
                <h3
                    class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-4"
                >
                    Soft Skills
                </h3>
                <div class="flex flex-wrap gap-2">
                    {
                        softSkills.map((skill) => (
                            <SkillBadge name={skill.name} variant={skill.variant} />
                        ))
                    }
                </div>
            </div>
        </BlurFade>
    </div>
</Section>
