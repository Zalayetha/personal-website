---
console.log("Skills Section Run 🏃");
import Section from "../layout/Section.astro";
import SkillBadge from "../ui/SkillBadge.astro";
import Marquee from "../magicui/Marquee.astro";
import { hardSkills, softSkills } from "../../data/portfolio";
---

<Section id="skills">
    <div class="max-w-2xl">
        <h2 class="font-newsreader text-3xl font-bold text-gray-950">Skills</h2>
        <p class="font-manrope text-base text-gray-500 mt-3">
            Skills I've developed over the years.
        </p>
    </div>

    <!-- Pure CSS Astro-Native Marquee Showcase -->
    <div class="relative mt-8 py-5 overflow-hidden rounded-3xl border border-gray-200/80 bg-white/70 shadow-xs">
        <!-- Row 1: Technical Skills Scrolling Forward -->
        <Marquee duration="22s" pauseOnHover={true} className="py-1">
            {
                hardSkills.map((skill) => (
                    <div class="flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-gray-950 text-white font-manrope text-sm font-semibold shadow-sm transition-transform duration-200 hover:scale-105 whitespace-nowrap">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
                        <span>{skill.name}</span>
                    </div>
                ))
            }
        </Marquee>

        <!-- Row 2: Soft Skills Scrolling in Reverse -->
        <Marquee reverse={true} duration="18s" pauseOnHover={true} className="py-1 mt-2.5">
            {
                softSkills.map((skill) => (
                    <div class="flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-white border border-gray-200 text-gray-800 font-manrope text-sm font-semibold shadow-2xs transition-transform duration-200 hover:scale-105 whitespace-nowrap">
                        <span class="w-2 h-2 rounded-full bg-gray-400" />
                        <span>{skill.name}</span>
                    </div>
                ))
            }
        </Marquee>
    </div>

    <div class="mt-8 grid md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-gray-200/80 shadow-xs h-full">
            <h3
                class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-4"
            >
                Technical
            </h3>
            <div class="flex flex-wrap gap-2">
                {
                    hardSkills.map((skill) => (
                        <SkillBadge name={skill.name} variant={skill.variant} />
                    ))
                }
            </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-gray-200/80 shadow-xs h-full">
            <h3
                class="font-manrope text-xs font-bold text-gray-400 uppercase tracking-wider mb-4"
            >
                Soft Skills
            </h3>
            <div class="flex flex-wrap gap-2">
                {
                    softSkills.map((skill) => (
                        <SkillBadge name={skill.name} variant={skill.variant} />
                    ))
                }
            </div>
        </div>
    </div>
</Section>
