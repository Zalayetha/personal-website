---
interface Props {
    name: string;
    variant: "dark" | "light";
}

const { name, variant } = Astro.props;
---

<span
    class={`inline-flex items-center px-3 py-1.5 rounded-lg font-manrope text-sm font-medium transition-all duration-200 hover:scale-[1.02] ${
        variant === "dark"
            ? "bg-gray-900 text-white shadow-sm hover:bg-gray-800"
            : "bg-white text-gray-700 border border-gray-200/90 shadow-2xs hover:border-gray-300 hover:text-gray-950"
    }`}
>
    {name}
</span>
