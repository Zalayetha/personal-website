---
import { MagicCard } from "../magicui/magic-card";

interface Props {
    title: string;
    description: string;
    image?: string;
    href: string;
    linkText: string;
}

const { title, description, image, href, linkText } = Astro.props;
---

<a href={href} class="block h-full group">
    <MagicCard
        client:visible
        gradientSize={280}
        gradientColor="rgba(55, 65, 81, 0.14)"
        className="p-6 transition-all duration-300 hover:border-gray-400/80 hover:shadow-xl hover:shadow-gray-200/60"
    >
        <div class="flex items-start justify-between mb-4">
            <div
                class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center overflow-hidden border border-gray-200/60"
            >
                {
                    image ? (
                        <img
                            src={image}
                            alt={`${title} icon`}
                            class="w-8 h-8 object-contain"
                        />
                    ) : (
                        <span class="font-newsreader text-xl font-bold text-gray-600">
                            {title.charAt(0)}
                        </span>
                    )
                }
            </div>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400 transition-transform duration-300 group-hover:text-gray-900 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
            >
        </div>
        <div class="font-newsreader text-xl font-semibold text-gray-950 mb-2">
            {title}
        </div>
        <div class="font-manrope text-sm text-gray-500 leading-relaxed mb-4">
            {description}
        </div>
        <span
            class="font-manrope text-sm font-medium text-gray-400 transition-colors duration-300 group-hover:text-gray-950"
        >
            {linkText} →
        </span>
    </MagicCard>
</a>
