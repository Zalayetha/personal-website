---
import type { Experience } from "../../data/portfolio";

interface Props {
    experience: Experience;
}

const { experience } = Astro.props;
---

<div class="relative pl-6 sm:pl-8 group">
    <!-- Timeline node indicator -->
    <div
        class="absolute left-0 top-1.5 w-3 h-3 rounded-full bg-white border-2 border-gray-400 transition-colors duration-300 group-hover:border-gray-900 group-hover:bg-gray-900"
    >
    </div>

    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
        <div>
            <h4 class="font-newsreader text-lg sm:text-xl font-semibold text-gray-950 group-hover:text-gray-800 transition-colors">
                {experience.company}
            </h4>
            <p class="font-manrope text-sm font-medium text-gray-700">
                {experience.role}
            </p>
        </div>
        <p class="font-manrope text-xs sm:text-sm text-gray-500 whitespace-nowrap">
            {experience.location} · {experience.period}
        </p>
    </div>
</div>
