---
import type { Experience } from "../../data/portfolio";

interface Props {
    experience: Experience;
}

const { experience } = Astro.props;
---

<div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8">
    <div class="flex-1">
        <h4 class="font-newsreader text-lg font-semibold text-gray-950">
            {experience.company}
        </h4>
    </div>
    <div class="flex-1">
        <p class="font-manrope font-medium text-gray-700">
            {experience.role}
        </p>
        <p class="font-manrope text-sm text-gray-500">
            {experience.location} · {experience.period}
        </p>
    </div>
</div>
