---
import type { Publication } from "../../data/portfolio";
import { MagicCard } from "../magicui/magic-card";

interface Props {
    publication: Publication;
}

const { publication } = Astro.props;
---

<a href={publication.url} target="_blank" class="block group">
    <MagicCard
        client:visible
        gradientSize={260}
        gradientColor="rgba(55, 65, 81, 0.12)"
        className="p-6 transition-all duration-300 hover:border-gray-400/80 hover:shadow-lg hover:shadow-gray-200/50"
    >
        <div class="flex items-start justify-between gap-4">
            <div>
                <h4
                    class="font-newsreader text-lg font-semibold text-gray-950 group-hover:text-gray-700 transition-colors"
                >
                    {publication.title}
                </h4>
                <p class="font-manrope text-sm text-gray-500 mt-1">
                    {publication.authors}
                </p>
                <p class="font-manrope text-sm text-gray-400 mt-0.5">
                    {publication.venue}
                </p>
            </div>
            <div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center shrink-0 border border-gray-200/60 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-gray-500 group-hover:text-gray-950"
                    ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
                >
            </div>
        </div>
    </MagicCard>
</a>
