---
import "../../styles/styles.css";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { blogPosts } from "../../data/portfolio";

export function getStaticPaths() {
    return blogPosts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const hasEmbeddedVideo = post.embeddedVideo !== undefined;
const hasImages = post.images !== undefined;
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/sprout.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{post.title} | Zaghy Zalayetha</title>
        <meta name="description" content={post.excerpt} />
    </head>
    <body class="min-h-screen flex flex-col bg-[#f4f4ee] text-[#42443f] font-sans antialiased selection:bg-[#d5d6cf] selection:text-[#151614]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12">
            <div class="mb-8">
                <a
                    href="/writing"
                    class="text-link text-xs text-[#676a62] hover:text-[#151614]"
                >
                    <span aria-hidden="true">&larr;</span>
                    <span>Back to Writing</span>
                </a>
            </div>

            <article class="max-w-2xl mx-auto w-full">
                <header class="border-b border-[#d1d3ca] pb-8 mb-8">
                    <time class="eyebrow block mb-3">
                        {post.date}
                    </time>
                    <h1 class="text-[clamp(28px,4vw,40px)] font-normal tracking-[-0.04em] text-[#151614] leading-[1.2] m-0 mb-4">
                        {post.title}<span class="text-[#888985]">.</span>
                    </h1>
                    <div class="flex flex-wrap gap-2">
                        {
                            post.tags.map((tag) => (
                                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#eaeae3] text-[#42443f] border border-[#d1d3ca]/60">
                                    #{tag}
                                </span>
                            ))
                        }
                    </div>
                </header>

                <div class="text-[16px] sm:text-[17px] text-[#42443f] leading-[1.85] whitespace-pre-line space-y-4">
                    {post.content}
                </div>

                {
                    hasEmbeddedVideo && (
                        <div class="mt-8 rounded-xl overflow-hidden border border-[#d1d3ca] bg-[#eaeae3]">
                            <iframe
                                src={post.embeddedVideo}
                                height="399"
                                width="100%"
                                allowfullscreen=""
                                title="Embedded post video"
                            />
                        </div>
                    )
                }

                {
                    hasImages && (
                        <div class="mt-8 flex flex-col sm:flex-row gap-4 items-center justify-center">
                            {post.images?.map((image, index) => (
                                <img
                                    src={image}
                                    alt={`Image ${index + 1}`}
                                    class="rounded-xl object-cover w-full border border-[#d1d3ca]"
                                />
                            ))}
                        </div>
                    )
                }
            </article>
        </main>
        <Footer />
    </body>
</html>
