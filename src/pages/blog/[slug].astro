---
import "../../styles/styles.css";
import { Header, Footer } from "../../components/layout";
import { Section } from "../../components/layout/Section";
import { ArrowLeft, Calendar, Tag } from "lucide-react";
import { blogPosts } from "../../data/portfolio";

export function getStaticPaths() {
    return blogPosts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/sprout.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{post.title} - Zaghy Zalayetha</title>
    </head>
    <body>
        <Header />
        <main>
            <Section id="blog-post">
                <div class="max-w-3xl mx-auto">
                    <a
                        href="/blog"
                        class="inline-flex items-center gap-2 font-manrope text-sm text-gray-500 hover:text-gray-700 transition-colors mb-8"
                    >
                        <ArrowLeft className="w-4 h-4" />
                        Back to Blog
                    </a>

                    <article>
                        <header class="mb-8">
                            <div class="flex items-center gap-2 mb-3">
                                <Calendar className="w-4 h-4 text-gray-400" />
                                <span
                                    class="font-manrope text-sm text-gray-400"
                                >
                                    {post.date}
                                </span>
                            </div>
                            <h1
                                class="font-newsreader text-3xl lg:text-4xl font-bold text-gray-950 mb-4"
                            >
                                {post.title}
                            </h1>
                            <div class="flex flex-wrap gap-2">
                                {
                                    post.tags.map((tag) => (
                                        <span class="inline-flex items-center gap-1 font-manrope text-xs px-3 py-1 rounded-full bg-gray-100 text-gray-600">
                                            <Tag className="w-3 h-3" />
                                            {tag}
                                        </span>
                                    ))
                                }
                            </div>
                        </header>

                        <div
                            class="font-manrope text-gray-700 leading-relaxed whitespace-pre-line"
                        >
                            {post.content}
                        </div>
                    </article>
                </div>
            </Section>
        </main>
        <Footer />
    </body>
</html>
