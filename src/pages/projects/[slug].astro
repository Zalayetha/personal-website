---
import "../../styles/styles.css";
import Favicon from "../../components/layout/Favicon.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { projects } from "../../data/portfolio";

export function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;

const {
    title,
    tagline,
    summary,
    impact,
    iveLearned,
    image,
    screenshots,
    techStack,
    features,
    links,
} = project;

const hasScreenshot = Boolean(screenshots);
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <Favicon />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Zaghy Zalayetha</title>
        <meta name="description" content={tagline} />
    </head>
    <body class="min-h-screen flex flex-col bg-white text-[#1e293b] font-sans antialiased selection:bg-[#d4f4e2] selection:text-[#008752]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12">
            <div class="mb-8">
                <a
                    href="/work"
                    class="text-link text-xs text-[#64748b] hover:text-[#008752]"
                >
                    <span aria-hidden="true">&larr;</span>
                    <span>Back to Work</span>
                </a>
            </div>

            <header class="border-b border-[#e2e8f0] pb-8 sm:pb-10 mb-8 sm:mb-12">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6">
                    <div class="flex items-start gap-4">
                        {
                            image && (
                                <div class="w-14 h-14 rounded-xl border border-[#e2e8f0] bg-[#f8fafc] flex items-center justify-center p-2 shrink-0">
                                    <img
                                        src={image}
                                        alt={`${title} icon`}
                                        class="w-10 h-10 object-contain"
                                    />
                                </div>
                            )
                        }
                        <div>
                            <span class="eyebrow block mb-1 text-[#64748b]">Case Study</span>
                            <h1 class="text-[clamp(28px,4vw,40px)] font-bold tracking-[-0.04em] text-[#0f172a] leading-[1.15] m-0">
                                {title}<span class="text-[#008752]">.</span>
                            </h1>
                            <p class="text-[15px] sm:text-[16px] text-[#64748b] leading-[1.7] mt-2 max-w-xl">
                                {tagline}
                            </p>
                        </div>
                    </div>

                    <!-- Links -->
                    <div class="flex flex-wrap items-center gap-3">
                        {
                            links.github && (
                                <a
                                    href={links.github}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="text-link text-xs px-3.5 py-1.5 rounded-lg border border-[#008752] bg-[#008752] text-white hover:bg-[#007346] font-medium"
                                >
                                    <span>GitHub</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                            )
                        }
                        {
                            links.live && (
                                <a
                                    href={links.live}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="text-link text-xs px-3.5 py-1.5 rounded-lg border border-[#008752] bg-[#008752] text-white hover:bg-[#007346] font-medium"
                                >
                                    <span>Live Demo</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                            )
                        }
                        {
                            links.appStore && (
                                <a
                                    href={links.appStore}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="text-link text-xs px-3 py-1.5 rounded-lg border border-[#e2e8f0] bg-[#f8fafc] text-[#0f172a] hover:bg-[#f1f5f9] font-medium"
                                >
                                    <span>App Store</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                            )
                        }
                        {
                            links.playStore && (
                                <a
                                    href={links.playStore}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="text-link text-xs px-3 py-1.5 rounded-lg border border-[#e2e8f0] bg-[#f8fafc] text-[#0f172a] hover:bg-[#f1f5f9] font-medium"
                                >
                                    <span>Play Store</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                            )
                        }
                    </div>
                </div>

                <!-- Tech Tags -->
                <div class="flex flex-wrap items-center gap-2 pt-6">
                    {
                        techStack.map((tech) => (
                            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#e8f8f0] text-[#008752] border border-[#008752]/20 font-medium">
                                {tech}
                            </span>
                        ))
                    }
                </div>
            </header>

            <!-- Content Flow -->
            <div class="space-y-12">
                <!-- Overview -->
                <section class="border-b border-[#e2e8f0] pb-10">
                    <h2 class="text-[19px] font-semibold tracking-[-0.03em] text-[#0f172a] mb-3">
                        Overview<span class="text-[#008752]">.</span>
                    </h2>
                    <p class="text-[15px] text-[#1e293b] leading-[1.85] whitespace-pre-line max-w-3xl">
                        {summary}
                    </p>
                </section>

                <!-- Impact -->
                <section class="border-b border-[#e2e8f0] pb-10">
                    <h2 class="text-[19px] font-semibold tracking-[-0.03em] text-[#0f172a] mb-3">
                        Impact &amp; Results<span class="text-[#008752]">.</span>
                    </h2>
                    <p class="text-[15px] text-[#1e293b] leading-[1.85] whitespace-pre-line max-w-3xl">
                        {impact}
                    </p>
                </section>

                <!-- Key Features -->
                <section class="border-b border-[#e2e8f0] pb-10">
                    <h2 class="text-[19px] font-semibold tracking-[-0.03em] text-[#0f172a] mb-4">
                        Key Features<span class="text-[#008752]">.</span>
                    </h2>
                    <ul class="space-y-2 text-[14px] text-[#1e293b] max-w-3xl pl-5 list-disc marker:text-[#008752]">
                        {
                            features.map((feature) => (
                                <li>{feature}</li>
                            ))
                        }
                    </ul>
                </section>

                <!-- Takeaways -->
                <section class="border-b border-[#e2e8f0] pb-10">
                    <h2 class="text-[19px] font-semibold tracking-[-0.03em] text-[#0f172a] mb-3">
                        Engineering Takeaways<span class="text-[#008752]">.</span>
                    </h2>
                    <p class="text-[15px] text-[#1e293b] leading-[1.85] whitespace-pre-line max-w-3xl">
                        {iveLearned}
                    </p>
                </section>

                <!-- Screenshots -->
                {
                    hasScreenshot && (
                        <section class="pb-8">
                            <h2 class="text-[19px] font-semibold tracking-[-0.03em] text-[#0f172a] mb-4">
                                Preview<span class="text-[#008752]">.</span>
                            </h2>
                            <div class="rounded-xl overflow-hidden border border-[#e2e8f0] bg-[#f8fafc]">
                                <img
                                    src={screenshots}
                                    alt={`${title} preview`}
                                    class="w-full h-auto object-cover"
                                />
                            </div>
                        </section>
                    )
                }
            </div>
        </main>
        <Footer />
    </body>
</html>
