---
import Favicon from "../components/layout/Favicon.astro";
import SEO from "../components/layout/SEO.astro";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <Favicon />
  <title>Zaghy Island | Interactive 3D Portfolio Tour</title>
  <meta name="description" content="Explore Zaghy Zalayetha's portfolio as an interactive 3D island." />
  <SEO
    title="Zaghy Island | Interactive 3D Portfolio Tour"
    description="Explore Zaghy Zalayetha's portfolio as an interactive 3D island."
  />
  <meta name="claude:viewport-fit-sides" content="cover" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <style is:global>
  /* Layout: full-bleed 3D island, HUD pinned to the edges, one info card that rises when you reach a stop. */
  :root{
    --sea:#7FB3C4;
    --grass:#A9C98B;
    --ink:#1E2B33;
    --panel:rgba(248,249,246,.93);
    --signal:#F2552C;
    --leaf:#2F8F5B;
    --bean:#5A3825;
    --muted:#56656D;
    --line:rgba(30,43,51,.16);
    --display:'Bricolage Grotesque',system-ui,-apple-system,'Segoe UI',sans-serif;
    --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
    color-scheme:light;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  html{scroll-padding-top:env(safe-area-inset-top,0px)}
  html,body{height:100%}
  body{
    margin:0;padding:0;
    font:14px -apple-system,BlinkMacSystemFont,sans-serif;
    background:var(--sea);color:var(--ink);font-family:var(--display);
    padding-left:max(16px,env(safe-area-inset-left,0px));
    padding-right:max(16px,env(safe-area-inset-right,0px));
    padding-block:0;overflow:hidden;touch-action:none;
    -webkit-user-select:none;user-select:none;
  }
  img{max-width:100%}
  [hidden]:not([hidden=until-found i]){display:none!important}

  #gl{position:fixed;inset:0;width:100%;height:100%;display:block}
  #hud{
    position:fixed;inset:0;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between;
    padding-left:max(16px,env(safe-area-inset-left,0px));
    padding-right:max(16px,env(safe-area-inset-right,0px));
    padding-top:calc(14px + env(safe-area-inset-top,0px));
    padding-bottom:calc(14px + env(safe-area-inset-bottom,0px));
  }
  .top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  .brand{padding:8px 12px;min-width:0;pointer-events:auto;text-decoration:none;color:inherit;cursor:pointer;display:block}
  .brand:focus-visible{outline:3px solid var(--signal);outline-offset:2px}
  .brand b{display:block;font-weight:800;font-size:22px;letter-spacing:-.02em;line-height:1}
  .brand span{display:block;margin-top:5px;font:400 11px/1.3 var(--mono);color:var(--muted)}
  .stats{display:flex;flex-direction:column;align-items:flex-end;gap:8px;min-width:0}
  .row{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
  .pill{padding:7px 10px;font:600 12px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;display:flex;align-items:center;gap:6px;font-variant-numeric:tabular-nums}
  .pill svg{width:14px;height:14px;flex:none}
  .snd{pointer-events:auto;cursor:pointer;color:var(--ink);border:1px solid var(--line)}
  .snd:focus-visible{outline:3px solid var(--signal);outline-offset:2px}
  .stam{width:132px;height:8px;border-radius:99px;background:rgba(248,249,246,.6);border:1px solid var(--line);overflow:hidden}
  .stam i{display:block;height:100%;width:100%;background:var(--signal);transform-origin:left center}
  #map{width:104px;height:104px;border-radius:50%;box-shadow:0 4px 14px rgba(30,43,51,.2)}
  #toast{align-self:center;position:absolute;top:calc(74px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);padding:8px 14px;font:600 12px/1.2 var(--mono);letter-spacing:.04em;white-space:nowrap;max-width:calc(100% - 32px);overflow:hidden;text-overflow:ellipsis}
  #toast.in{animation:pop .25s ease-out}
  @keyframes pop{from{opacity:0;transform:translate(-50%,-6px)}to{opacity:1;transform:translate(-50%,0)}}
  .bottom{display:flex;flex-direction:column;align-items:center;gap:10px}
  #card{pointer-events:auto;width:100%;max-width:440px;padding:14px 16px 16px;box-shadow:0 12px 32px rgba(30,43,51,.22);animation:rise .22s ease-out}
  @keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .kicker{font:600 11px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--signal)}
  #card h2{margin:8px 0 0;font-weight:800;font-size:24px;line-height:1.1;letter-spacing:-.015em;text-wrap:balance}
  .role{margin:6px 0 0;font:600 13px/1.4 var(--mono);color:var(--muted)}
  .desc{margin:8px 0 0;font-size:15px;line-height:1.45;max-width:65ch}
  .links{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:6px}
  .links a,.open{pointer-events:auto}
  .links a{color:var(--ink);font-size:14px;line-height:1.3;text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
  .links a small{font:400 11px var(--mono);color:var(--muted);margin-left:6px}
  .btn,.open{display:inline-flex;align-items:center;gap:6px;margin-top:12px;padding:9px 14px;background:var(--ink);color:#fff;border:0;border-radius:6px;font:700 14px/1 var(--display);text-decoration:none;cursor:pointer}
  .btn:focus-visible,.open:focus-visible,.links a:focus-visible,.copy:focus-visible,#sprint:focus-visible{outline:3px solid var(--signal);outline-offset:2px}
  .btn.alt{background:transparent;color:var(--ink);border:1px solid var(--ink)}
  .contact{margin-top:10px;display:flex;flex-direction:column;gap:8px}
  .mail{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .email{font:600 15px/1.2 var(--mono);-webkit-user-select:text;user-select:text;padding:6px 8px;background:rgba(30,43,51,.07);border-radius:5px;overflow-wrap:anywhere}
  .copy{padding:7px 10px;background:transparent;border:1px solid var(--ink);border-radius:6px;font:600 12px/1 var(--mono);cursor:pointer;color:var(--ink)}
  .social{display:flex;gap:14px;flex-wrap:wrap}
  .social a{font-size:14px;color:var(--ink)}
  .hint{margin:0;padding:6px 10px;font:400 11px/1.3 var(--mono);color:var(--ink);text-align:center}
  .controls{display:none;width:100%;justify-content:space-between;align-items:flex-end;pointer-events:none}
  #joy{pointer-events:auto;position:relative;width:116px;height:116px;border-radius:50%;background:rgba(248,249,246,.55);border:2px solid rgba(248,249,246,.85);touch-action:none}
  #knob{position:absolute;left:50%;top:50%;width:48px;height:48px;margin:-24px 0 0 -24px;border-radius:50%;background:var(--ink);opacity:.85}
  #sprint{pointer-events:auto;width:84px;height:84px;border-radius:50%;border:2px solid var(--ink);background:rgba(248,249,246,.85);color:var(--ink);font:700 12px var(--mono);letter-spacing:.06em;text-transform:uppercase;touch-action:none}
  #sprint.on{background:var(--signal);color:#fff;border-color:var(--signal)}
  @media (pointer:coarse){.controls{display:flex}.hint{display:none}#map{width:88px;height:88px}}
  @media (max-width:480px){.brand b{font-size:19px}.stam{width:104px}}
  .overlay{position:fixed;inset:0;z-index:5;display:flex;align-items:center;justify-content:center;
    padding:max(16px,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) max(16px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));
    background:rgba(30,43,51,.42)}
  .sheet{width:100%;max-width:470px;padding:22px 22px 24px;box-shadow:0 20px 50px rgba(30,43,51,.3);max-height:100%;overflow:auto}
  .sheet h1{margin:10px 0 0;font-weight:800;font-size:clamp(34px,9vw,46px);line-height:1;letter-spacing:-.03em;text-wrap:balance}
  .sheet p{margin:12px 0 0;font-size:16px;line-height:1.5;max-width:65ch}
  .keys{margin-top:14px;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font:400 12px/1.4 var(--mono);color:var(--muted)}
  .keys b{color:var(--ink);font-weight:600}
  .fine{margin-top:14px;font:400 12px var(--mono)}
  .fine a{color:var(--ink)}
  @media (prefers-reduced-motion:reduce){#card,#toast.in{animation:none}}
  </style>
</head>
<body>

<canvas id="gl" aria-label="3D island map of zaghy.zalsoft.com"></canvas>

<div id="hud">
  <header class="top">
    <a href="/" class="brand panel" title="Return to regular site"><b>zaghy.</b><span>Understand deeply. Build simply.</span></a>
    <div class="stats">
      <div class="row">
        <div class="pill panel" title="Stops visited"><span>Stops</span> <b id="stopsN">0</b>/8</div>
        <div class="pill panel" title="Coffee collected">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5h9v4a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V5Z" fill="#5A3825"/><path d="M11 6h1.5a2 2 0 0 1 0 4H11" fill="none" stroke="#5A3825" stroke-width="1.4"/><path d="M5 1.5c-.8 1 .8 1.5 0 2.5M8 1.5c-.8 1 .8 1.5 0 2.5" fill="none" stroke="#56656D" stroke-width="1" stroke-linecap="round"/></svg>
          <b id="coffeeN">0</b>/18
        </div>
        <button id="mute" class="pill panel snd" type="button" aria-pressed="false">Sound on</button>
        <button id="clockBtn" class="pill panel snd" type="button" title="Skip ahead 3 hours"><span id="phase">Day</span> <b id="clock">10:50</b></button>
      </div>
      <div class="stam" title="Sprint stamina"><i id="stamBar"></i></div>
      <canvas id="map" width="208" height="208" aria-hidden="true"></canvas>
    </div>
  </header>
  <div id="toast" class="panel" hidden></div>
  <footer class="bottom">
    <section id="card" class="panel" hidden aria-live="polite"></section>
    <div class="controls">
      <div id="joy" aria-label="Move"><i id="knob"></i></div>
      <button id="sprint" type="button">Sprint</button>
    </div>
    <p class="hint panel">WASD or arrows to walk · Shift to sprint · M to mute · T to skip time</p>
  </footer>
</div>

<div id="intro" class="overlay">
  <div class="sheet panel">
    <div class="kicker">zaghy.zalsoft.com / game</div>
    <h1>Zaghy Island</h1>
    <p>The portfolio, built as a small island you can walk around. Visit eight stops: three jobs, four projects and the writing. Coffee refills your sprint.</p>
    <div class="keys"><b>Walk</b><span>W A S D or arrow keys, or the stick on a phone</span><b>Sprint</b><span>Shift, or the Sprint button</span><b>Goal</b><span>Reach every glowing ring, then say hello</span></div>
    <button id="start" class="btn" type="button">Start walking</button>
    <div class="fine"><a href="/">Open the regular site ↗</a></div>
  </div>
</div>

<div id="finale" class="overlay" hidden>
  <div class="sheet panel">
    <div class="kicker">All 8 stops visited</div>
    <h1>That is the tour.</h1>
    <p id="finaleText"></p>
    <div id="finaleContact"></div>
    <button id="keep" class="btn alt" type="button">Keep exploring</button>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline>
(function(){
'use strict';
var T=THREE;
var SITE=(typeof window !== 'undefined' && window.location.origin) ? window.location.origin : 'https://zaghy.zalsoft.com';
var EMAIL='zaghy@zalsoft.com';
var GITHUB='https://github.com/Zalayetha';
var LINKEDIN='https://www.linkedin.com/in/mohammad-zaghy-zalayetha-sofjan/';
var SEA='#7FB3C4',SIGNAL='#F2552C',LEAF='#2F8F5B',INK='#1E2B33',BEAN='#5A3825';
var reduce=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);
var TOTAL_COFFEE=18;

/* sound effects only, synthesized with Web Audio. No music. */
var Snd=(function(){
  var ctx=null,master=null,muted=false,noiseBuf=null;
  try{muted=localStorage.getItem('zi-muted')==='1';}catch(e){}
  function init(){
    if(ctx){if(ctx.state==='suspended')ctx.resume();return;}
    var AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;
    try{ctx=new AC();}catch(e){ctx=null;return;}
    master=ctx.createGain();master.gain.value=muted?0:.5;master.connect(ctx.destination);
    noiseBuf=ctx.createBuffer(1,Math.floor(ctx.sampleRate*.5),ctx.sampleRate);
    var d=noiseBuf.getChannelData(0);for(var i=0;i<d.length;i++)d[i]=Math.random()*2-1;
  }
  function tone(f,dur,type,vol,to,delay){
    if(!ctx||muted)return;
    var t=ctx.currentTime+(delay||0),o=ctx.createOscillator(),g=ctx.createGain();
    o.type=type||'sine';o.frequency.setValueAtTime(f,t);if(to)o.frequency.exponentialRampToValueAtTime(to,t+dur);
    g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(vol||.2,t+.01);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.02);
  }
  function noise(dur,freq,q,vol,type,to){
    if(!ctx||muted)return;
    var t=ctx.currentTime,s=ctx.createBufferSource(),f=ctx.createBiquadFilter(),g=ctx.createGain();
    s.buffer=noiseBuf;f.type=type||'lowpass';f.frequency.setValueAtTime(freq,t);if(to)f.frequency.exponentialRampToValueAtTime(to,t+dur);f.Q.value=q||1;
    g.gain.setValueAtTime(vol||.2,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    s.connect(f);f.connect(g);g.connect(master);s.start(t);s.stop(t+dur+.02);
  }
  return {
    init:init,
    isMuted:function(){return muted;},
    setMuted:function(m){muted=m;try{localStorage.setItem('zi-muted',m?'1':'0');}catch(e){}if(master)master.gain.value=m?0:.5;},
    step:function(){noise(.07,300+Math.random()*120,1,.22,'lowpass');},
    sprint:function(){noise(.35,500,2,.12,'bandpass',2200);},
    coffee:function(){tone(660,.1,'sine',.22);tone(990,.16,'sine',.2,null,.08);},
    near:function(){tone(520,.07,'triangle',.12);},
    visit:function(){[523,659,784].forEach(function(f,i){tone(f,.22,'triangle',.2,null,i*.09);});},
    finale:function(){[523,659,784,1047].forEach(function(f,i){tone(f,.35,'triangle',.22,null,i*.12);});},
    click:function(){tone(440,.06,'square',.08,330);},
    empty:function(){tone(200,.18,'sawtooth',.1,120);}
  };
})();

var STOPS=[
 {id:'english',kind:'Career · 1 of 3',name:'English Space',role:'Web Developer',years:'2022–2023',desc:'First role on the timeline.',url:SITE+'/about',cta:'More about me ↗',pos:[-34,18],cr:6,ir:11,label:'English Space',sub:'2022–2023',labelY:11},
 {id:'univ',kind:'Career · 2 of 3',name:'Universitas Budi Luhur',role:'Staff Programmer',years:'2023–2026',desc:'Three years as staff programmer.',url:SITE+'/about',cta:'More about me ↗',pos:[-38,-16],cr:8,ir:13,label:'Universitas Budi Luhur',sub:'2023–2026',labelY:18},
 {id:'c3arbon',kind:'Career · 3 of 3 · Currently',name:'C3ARBON',role:'Software Engineer',years:'2026–now',desc:'Current role. The road ends here, for now.',url:SITE+'/about',cta:'More about me ↗',pos:[-8,-40],cr:6,ir:11,label:'C3ARBON',sub:'2026–now',labelY:24},
 {id:'student',kind:'Project',name:'Student Budi Luhur',role:'',years:'',desc:'Academic companion app for university students.',url:SITE+'/work/student-budi-luhur',cta:'View project ↗',pos:[26,-26],cr:5,ir:10,label:'Student Budi Luhur',sub:'Project',labelY:16},
 {id:'employee',kind:'Project',name:'Employee Budi Luhur',role:'',years:'',desc:'Employee management for university staff.',url:SITE+'/work/employee-budi-luhur',cta:'View project ↗',pos:[42,0],cr:6.5,ir:12,label:'Employee Budi Luhur',sub:'Project',labelY:16},
 {id:'ektp',kind:'Project',name:'E-KTP Verification System',role:'',years:'',desc:'OCR-based identity card verification.',url:SITE+'/work/ektp-verification',cta:'View project ↗',pos:[30,28],cr:6,ir:11,label:'E-KTP Verification',sub:'Project',labelY:13},
 {id:'santana',kind:'Project',name:'Santana',role:'',years:'',desc:'Disaster text classification with ML.',url:SITE+'/work/santana',cta:'View project ↗',pos:[2,42],cr:4,ir:10,label:'Santana',sub:'Project',labelY:17},
 {id:'notes',kind:'Writing',name:'Notes & thoughts',role:'',years:'',desc:'Recent posts from the blog.',url:SITE+'/writing',cta:'All writing ↗',pos:[-24,38],cr:5.5,ir:10.5,label:'Notes & thoughts',sub:'Writing',labelY:13,
  links:[{t:'Building MyNiyyah #1',d:'January 2026',u:SITE+'/blog/building-myniyyah-mvp-reactnative'},
         {t:'Building MyNiyyah #2',d:'February 2026',u:SITE+'/blog/building-myniyyah-journal-categorization'},
         {t:'Building MyNiyyah #3',d:'February 2026',u:SITE+'/blog/building-myniyyah-editor-block-system'},
         {t:'Planning Ahead for Productivity',d:'January 2026',u:SITE+'/blog/planning-ahead-productivity'}]}
];
STOPS.forEach(function(s){s.counts=true;s.visited=false;});
var MAIL={id:'mail',kind:'Say hello',name:"Let's talk",desc:'Drop a line about what you want to build.',contact:true,pos:[9,-8],cr:1,ir:6,counts:false,visited:false};

var ROADS=[
 [[0,0],[-18,12],[-34,18],[-36,0],[-38,-16],[-24,-30],[-8,-40]],
 [[0,0],[14,-14],[26,-26],[40,-14],[42,0],[40,16],[30,28],[16,38],[2,42]],
 [[2,42],[-12,42],[-24,38]],
 [[0,0],[9,-8]]
];

function rng(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function rr(g,x,y,w,h,r){g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}
function $(id){return document.getElementById(id);}

function fail(err){
  var p=document.querySelector('#intro .sheet');
  if(err&&err.message){p.innerHTML='<div class="kicker">zaghy.zalsoft.com / game</div><h1>Something broke</h1><p>The island hit an error while loading. Reload to try again.</p><div class="fine">'+String(err.message).replace(/</g,'&lt;')+'</div>';return;}
  p.innerHTML='<div class="kicker">zaghy.zalsoft.com / game</div><h1>WebGL is off</h1><p>This browser could not start 3D graphics. Try another browser, or open the regular site.</p><div class="fine"><a href="/" rel="noopener">Open the regular site ↗</a></div>';
}

var fontsReady=(document.fonts&&document.fonts.load)?Promise.race([
  Promise.all([document.fonts.load('800 40px "Bricolage Grotesque"'),document.fonts.load('600 24px "JetBrains Mono"')]).catch(function(){}),
  new Promise(function(r){setTimeout(r,2500);})
]):Promise.resolve();
fontsReady.then(function(){try{boot();}catch(e){fail(e);}});

function boot(){
var canvas=$('gl');
var renderer;
try{renderer=new T.WebGLRenderer({canvas:canvas,antialias:true});}catch(e){fail();return;}
var W=window.innerWidth,H=window.innerHeight;
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.setSize(W,H,false);
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=T.PCFSoftShadowMap;
var scene=new T.Scene();
scene.background=new T.Color(SEA);
scene.fog=new T.Fog(SEA,110,260);
var camera=new T.PerspectiveCamera(40,W/H,1,600);

var hemi=new T.HemisphereLight(0xffffff,0x9db98a,.9);scene.add(hemi);
var sun=new T.DirectionalLight(0xfff3df,.95);
sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.bias=-0.0006;
var sc=sun.shadow.camera;sc.left=-52;sc.right=52;sc.top=52;sc.bottom=-52;sc.near=1;sc.far=170;
scene.add(sun);scene.add(sun.target);

function mat(c,o){return new T.MeshStandardMaterial(Object.assign({color:c,flatShading:true,roughness:.88,metalness:0},o||{}));}
function add(parent,geo,m,x,y,z,noShadow){var me=new T.Mesh(geo,m);me.position.set(x,y,z);if(!noShadow){me.castShadow=true;me.receiveShadow=true;}parent.add(me);return me;}
function box(p,w,h,d,m,x,y,z){return add(p,new T.BoxGeometry(w,h,d),m,x,y,z);}
function cyl(p,rt,rb,h,seg,m,x,y,z){return add(p,new T.CylinderGeometry(rt,rb,h,seg),m,x,y,z);}

/* island */
var island=new T.Mesh(new T.CylinderGeometry(61,63,4,56),[mat('#CDB98A'),mat('#A9C98B'),mat('#CDB98A')]);
island.position.y=-2;island.receiveShadow=true;scene.add(island);
var rg=rng(7);
['#9CBF7F','#B6D49A','#A2C485'].forEach(function(col,k){
  for(var i=0;i<6;i++){
    var a=rg()*6.283,r=Math.sqrt(rg())*52,rad=4+rg()*6;
    var m=new T.Mesh(new T.CircleGeometry(rad,18),new T.MeshStandardMaterial({color:col,roughness:1,flatShading:true}));
