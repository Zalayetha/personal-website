/* trees & rocks */
var R=rng(2026);
var trunkG=new T.CylinderGeometry(.25,.35,1.6,6),c1G=new T.ConeGeometry(2,3.2,6),c2G=new T.ConeGeometry(1.5,2.6,6);
var trunkM=mat('#6B4A32'),greens=[mat('#3F8A57'),mat('#4C9B63'),mat('#3A7F55')],greens2=[mat('#4C9B63'),mat('#5AA96E'),mat('#47935F')];
var trees=[];
for(var n=0,tries=0;n<80&&tries<900;tries++){
  var a=R()*6.283,r=Math.sqrt(R())*57,x=Math.cos(a)*r,z=Math.sin(a)*r;
  if(nearStop(x,z,3.8)||nearRoad(x,z,3.4))continue;
  var ok=true;for(var k=0;k<trees.length;k++){if(Math.hypot(x-trees[k][0],z-trees[k][1])<3.4){ok=false;break;}}
  if(!ok)continue;
  trees.push([x,z]);n++;
  var tg=new T.Group();tg.position.set(x,0,z);var sc2=.8+R()*.6;tg.scale.set(sc2,sc2*(.9+R()*.3),sc2);tg.rotation.y=R()*6;
  var gi=Math.floor(R()*3);
  add(tg,trunkG,trunkM,0,.8,0);add(tg,c1G,greens[gi],0,3,0);add(tg,c2G,greens2[gi],0,4.9,0);
  scene.add(tg);colliders.push({x:x,z:z,r:.9*sc2});
}
var rockG=new T.DodecahedronGeometry(1,0),rockM=[mat('#9AA3A5'),mat('#8B9598')];
for(var q=0,rt=0;q<16&&rt<300;rt++){
  var ra=R()*6.283,rr2=Math.sqrt(R())*57,rx=Math.cos(ra)*rr2,rz=Math.sin(ra)*rr2;
  if(nearStop(rx,rz,3)||nearRoad(rx,rz,2.6))continue;
  var s3=.8+R()*1.1,rock=add(scene,rockG,rockM[q%2],rx,.3*s3,rz);rock.scale.set(s3,s3*.7,s3*.9);rock.rotation.set(R()*3,R()*3,R()*3);
  colliders.push({x:rx,z:rz,r:s3*.9});q++;
}

/* coffee */
var coffee=[];
(function(){
  var cupG=new T.CylinderGeometry(.55,.4,.8,10),topG=new T.CylinderGeometry(.5,.5,.05,10),handleG=new T.TorusGeometry(.28,.07,6,10);
  var cupM=mat('#FFFFFF'),topM=mat(BEAN);
  var glowM=new T.MeshBasicMaterial({color:SIGNAL,transparent:true,opacity:.35,depthWrite:false,fog:false});
  for(var n=0,tr=0;n<TOTAL_COFFEE&&tr<1200;tr++){
    var a=R()*6.283,r=Math.sqrt(R())*54,x=Math.cos(a)*r,z=Math.sin(a)*r;
    if(nearStop(x,z,4.5))continue;
    var bad=false;for(var i=0;i<colliders.length;i++){var c=colliders[i];if(Math.hypot(x-c.x,z-c.z)<c.r+1.8){bad=true;break;}}
    if(bad)continue;
    for(var j=0;j<coffee.length;j++){if(Math.hypot(x-coffee[j].x,z-coffee[j].z)<7){bad=true;break;}}
    if(bad)continue;
    var g=new T.Group();g.position.set(x,.9,z);scene.add(g);
    add(g,cupG,cupM,0,0,0);add(g,topG,topM,0,.4,0);var h=add(g,handleG,cupM,.6,0,0);
    var glow=new T.Mesh(new T.CircleGeometry(1.1,16),glowM);glow.rotation.x=-Math.PI/2;glow.position.set(x,.1,z);scene.add(glow);
    coffee.push({x:x,z:z,g:g,glow:glow,got:false,ph:R()*6});n++;
  }
})();
anims.push(function(t){
  coffee.forEach(function(c){if(c.got)return;c.g.position.y=1.1+Math.sin(t*2.2+c.ph)*.25;c.g.rotation.y=t*1.6+c.ph;});
});

/* clouds */
var clouds=[];
var cloudG=new T.IcosahedronGeometry(1,1),cloudM=new T.MeshStandardMaterial({color:0xffffff,flatShading:true,roughness:1,emissive:0x9fb4bd,emissiveIntensity:.25,fog:false});
for(var i=0;i<7;i++){
  var cg=new T.Group();var cn=3+Math.floor(R()*2);
  for(var k=0;k<cn;k++){var cs=add(cg,cloudG,cloudM,k*3.2-cn*1.4,R()*.8,R()*1.5,true);cs.scale.set(2.6+R()*1.6,1.6+R(),2.2+R()*1.4);}
  cg.position.set(-140+R()*280,32+R()*10,-80+R()*160);scene.add(cg);clouds.push(cg);
}
anims.push(function(t,dt){if(reduce)return;clouds.forEach(function(c){c.position.x+=dt*1.6;if(c.position.x>150)c.position.x=-150;});});
anims.push(function(t){if(reduce)return;foam.forEach(function(f,i){var p=((t*.12)+i/3)%1;f.scale.setScalar(1+p*.12);f.material.opacity=.5*(1-p);});});

/* player */
var player=new T.Group();scene.add(player);
var body=new T.Group();player.add(body);
box(body,1.5,1.7,1,mat('#27465B'),0,2.1,0);
add(body,new T.SphereGeometry(.72,12,10),mat('#E0B08A'),0,3.55,0);
var hair=add(body,new T.SphereGeometry(.76,12,8,0,6.283,0,1.45),mat('#1B1410'),0,3.62,-.05);
add(body,new T.SphereGeometry(.09,6,6),mat(INK),-.25,3.6,.66,true);add(body,new T.SphereGeometry(.09,6,6),mat(INK),.25,3.6,.66,true);
box(body,1.1,1.3,.5,mat(SIGNAL),0,2.2,-.75);
var armL=box(body,.4,1.3,.4,mat('#27465B'),-.95,2.1,0),armR=box(body,.4,1.3,.4,mat('#27465B'),.95,2.1,0);
var legL=box(player,.55,1.3,.6,mat('#1F2C36'),-.4,.65,0),legR=box(player,.55,1.3,.6,mat('#1F2C36'),.4,.65,0);
var P={x:0,z:9,vx:0,vz:0,rot:0,phase:0};
var lastStep=0,wasSprint=false;
var lantern=new T.PointLight(0xffd9a0,0,24,2);lantern.position.set(0,4.2,1.2);player.add(lantern);
var ffN=70,ffPos=new Float32Array(ffN*3),ffBase=[];
for(var fi=0;fi<ffN;fi++){var fa=R()*6.283,fr=Math.sqrt(R())*56;ffBase.push([Math.cos(fa)*fr,1+R()*3.5,Math.sin(fa)*fr,R()*6.283]);}
var ffGeo=new T.BufferGeometry();ffGeo.setAttribute('position',new T.BufferAttribute(ffPos,3));
var ffMat=new T.PointsMaterial({color:0xd8ff8a,size:5,sizeAttenuation:false,transparent:true,opacity:0,depthWrite:false,blending:T.AdditiveBlending,fog:false});
var fireflies=new T.Points(ffGeo,ffMat);fireflies.frustumCulled=false;scene.add(fireflies);
player.position.set(P.x,0,P.z);

/* camera */
var camOff=new T.Vector3(),camPos=new T.Vector3(P.x,24,P.z+26),camLook=new T.Vector3(P.x,1,P.z);
function sizeCam(){var k=W/H<1?1.55:1;camOff.set(0,24*k,26*k);}
sizeCam();camera.position.copy(camPos);camera.lookAt(camLook);
window.addEventListener('resize',function(){W=window.innerWidth;H=window.innerHeight;renderer.setSize(W,H,false);camera.aspect=W/H;camera.updateProjectionMatrix();sizeCam();});

/* input */
var keys={},joy={x:0,z:0},sprintTouch=false,running=false,paused=false;
var map={KeyW:'u',ArrowUp:'u',KeyS:'d',ArrowDown:'d',KeyA:'l',ArrowLeft:'l',KeyD:'r',ArrowRight:'r',ShiftLeft:'s',ShiftRight:'s'};
window.addEventListener('keydown',function(e){var k=map[e.code];if(!k)return;keys[k]=true;if(running)e.preventDefault();});
window.addEventListener('keyup',function(e){var k=map[e.code];if(k)keys[k]=false;});
window.addEventListener('blur',function(){keys={};});
var joyEl=$('joy'),knob=$('knob'),joyId=null;
function joyMove(e){
  var b=joyEl.getBoundingClientRect(),cx=b.left+b.width/2,cy=b.top+b.height/2,dx=e.clientX-cx,dy=e.clientY-cy,m=Math.hypot(dx,dy),max=b.width/2-6;
  if(m>max){dx*=max/m;dy*=max/m;}
  joy.x=dx/max;joy.z=dy/max;knob.style.transform='translate('+dx+'px,'+dy+'px)';
}
joyEl.addEventListener('pointerdown',function(e){joyId=e.pointerId;try{joyEl.setPointerCapture(e.pointerId);}catch(_){}joyMove(e);});
joyEl.addEventListener('pointermove',function(e){if(e.pointerId===joyId)joyMove(e);});
function joyEnd(e){if(e.pointerId!==joyId)return;joyId=null;joy.x=0;joy.z=0;knob.style.transform='';}
joyEl.addEventListener('pointerup',joyEnd);joyEl.addEventListener('pointercancel',joyEnd);
var sprintBtn=$('sprint');
sprintBtn.addEventListener('pointerdown',function(e){sprintTouch=true;sprintBtn.classList.add('on');try{sprintBtn.setPointerCapture(e.pointerId);}catch(_){}});
function sprintEnd(){sprintTouch=false;sprintBtn.classList.remove('on');}
sprintBtn.addEventListener('pointerup',sprintEnd);sprintBtn.addEventListener('pointercancel',sprintEnd);

/* HUD */
var stopsN=$('stopsN'),coffeeN=$('coffeeN'),stamBar=$('stamBar'),card=$('card'),toastEl=$('toast'),toastT=0;
var coffeeCount=0,visitedCount=0,stamina=100,finaleShown=false;
function toast(msg){toastEl.textContent=msg;toastEl.hidden=false;toastEl.classList.remove('in');void toastEl.offsetWidth;toastEl.classList.add('in');clearTimeout(toastT);toastT=setTimeout(function(){toastEl.hidden=true;},2200);}
function selectEl(el){try{var r=document.createRange();r.selectNodeContents(el);var s=getSelection();s.removeAllRanges();s.addRange(r);}catch(_){}}
function contactNode(){
  var d=document.createElement('div');d.className='contact';
  var m=document.createElement('div');m.className='mail';
  var em=document.createElement('span');em.className='email';em.textContent=EMAIL;
  var cp=document.createElement('button');cp.type='button';cp.className='copy';cp.textContent='Copy';
  cp.addEventListener('click',function(){
    function ok(){cp.textContent='Copied';setTimeout(function(){cp.textContent='Copy';},1400);}
    function fb(){selectEl(em);cp.textContent='Selected';setTimeout(function(){cp.textContent='Copy';},1400);}
    try{navigator.clipboard.writeText(EMAIL).then(ok,fb);}catch(_){fb();}
  });
  m.appendChild(em);m.appendChild(cp);d.appendChild(m);
  var so=document.createElement('div');so.className='social';
  [['GitHub ↗',GITHUB],['LinkedIn ↗',LINKEDIN]].forEach(function(l){var a=document.createElement('a');a.href=l[1];a.target='_blank';a.rel='noopener';a.textContent=l[0];so.appendChild(a);});
  d.appendChild(so);return d;
}
function el(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;}
function showCard(s){
  card.innerHTML='';
  if(!s){card.hidden=true;return;}
  card.appendChild(el('div','kicker',s.kind));
  card.appendChild(el('h2',null,s.name));
  var role=[s.role,s.years].filter(Boolean).join(' · ');
  if(role)card.appendChild(el('p','role',role));
  if(s.desc)card.appendChild(el('p','desc',s.desc));
  if(s.links){
    var ul=el('ul','links');
    s.links.forEach(function(l){var li=document.createElement('li');var a=document.createElement('a');a.href=l.u;a.target='_blank';a.rel='noopener';a.textContent=l.t;var sm=el('small',null,l.d);a.appendChild(sm);li.appendChild(a);ul.appendChild(li);});
    card.appendChild(ul);
  }
  if(s.contact)card.appendChild(contactNode());
  if(s.url){var o=document.createElement('a');o.className='open';o.href=s.url;o.target='_blank';o.rel='noopener';o.textContent=s.cta||'Open ↗';card.appendChild(o);}
  card.hidden=false;
}
function markVisited(s){
  Snd.visit();s.visited=true;visitedCount++;stopsN.textContent=visitedCount;
  s.ring.material.color.set(LEAF);s.ring.material.opacity=.9;s.arrow.visible=false;drawLabel(s);
  toast('Stop '+visitedCount+' of 8: '+s.label);
  if(visitedCount===8&&!finaleShown){finaleShown=true;setTimeout(openFinale,1400);}
}
function openFinale(){
  $('finaleText').textContent='You walked past all eight stops and picked up '+coffeeCount+' of '+TOTAL_COFFEE+' coffees. If something here looks like what you need built, say hello.';
  var fc=$('finaleContact');fc.innerHTML='';fc.appendChild(contactNode());
  Snd.finale();$('finale').hidden=false;running=false;showCard(null);
}
$('keep').addEventListener('click',function(){Snd.click();$('finale').hidden=true;running=true;});
$('start').addEventListener('click',function(){Snd.init();Snd.click();$('intro').hidden=true;running=true;});
var muteBtn=$('mute');
function syncMute(){muteBtn.textContent=Snd.isMuted()?'Sound off':'Sound on';muteBtn.setAttribute('aria-pressed',Snd.isMuted()?'true':'false');}
function toggleMute(){Snd.init();Snd.setMuted(!Snd.isMuted());syncMute();Snd.click();}
syncMute();
muteBtn.addEventListener('click',toggleMute);
window.addEventListener('keydown',function(e){if(e.code==='KeyM'&&!e.repeat)toggleMute();if(e.code==='KeyT'&&!e.repeat)skipTime();});
function skipTime(){dayT=(dayT+.125)%1;Snd.click();}
$('clockBtn').addEventListener('click',skipTime);

/* minimap */
var mapC=$('map'),mg=mapC.getContext('2d');
function drawMap(){
  var S=mapC.width,c=S/2,k=c/64;
  mg.clearRect(0,0,S,S);
  mg.beginPath();mg.arc(c,c,c-2,0,6.283);mg.fillStyle='rgba(248,249,246,.94)';mg.fill();
  mg.beginPath();mg.arc(c,c,58*k,0,6.283);mg.fillStyle='#A9C98B';mg.fill();
  mg.strokeStyle='#E8E5DD';mg.lineWidth=3;mg.lineJoin='round';
  ROADS.forEach(function(l){mg.beginPath();l.forEach(function(p,i){var X=c+p[0]*k,Y=c+p[1]*k;if(i)mg.lineTo(X,Y);else mg.moveTo(X,Y);});mg.stroke();});
  mg.fillStyle=BEAN;coffee.forEach(function(cf){if(cf.got)return;mg.beginPath();mg.arc(c+cf.x*k,c+cf.z*k,2.4,0,6.283);mg.fill();});
  STOPS.forEach(function(s){mg.beginPath();mg.arc(c+s.pos[0]*k,c+s.pos[1]*k,6,0,6.283);mg.fillStyle=s.visited?LEAF:SIGNAL;mg.fill();mg.lineWidth=2;mg.strokeStyle='#fff';mg.stroke();});
  mg.beginPath();mg.arc(c+MAIL.pos[0]*k,c+MAIL.pos[1]*k,3.5,0,6.283);mg.fillStyle=INK;mg.fill();
  mg.save();mg.translate(c+P.x*k,c+P.z*k);mg.rotate(Math.PI/2-P.rot);
  mg.beginPath();mg.moveTo(8,0);mg.lineTo(-5,5);mg.lineTo(-5,-5);mg.closePath();mg.fillStyle=INK;mg.fill();mg.lineWidth=2;mg.strokeStyle='#fff';mg.stroke();mg.restore();
}

/* day / night: one full day lasts four minutes, 06:00 is sunrise */
var DAY_SECONDS=240,dayT=.2;
function CC(h){return new T.Color(h);}
var skyKeys=[[0,CC('#E9B49A')],[.07,CC('#93C0D0')],[.25,CC('#7FB3C4')],[.42,CC('#8DB9C6')],[.5,CC('#E8956E')],[.56,CC('#4C4E80')],[.64,CC('#141C30')],[.86,CC('#141C30')],[.94,CC('#3F4670')],[1,CC('#E9B49A')]];
var skyCol=new T.Color();
function skyAt(t){
  for(var i=0;i<skyKeys.length-1;i++){var a=skyKeys[i],b=skyKeys[i+1];if(t>=a[0]&&t<=b[0]){skyCol.copy(a[1]).lerp(b[1],(t-a[0])/(b[0]-a[0]));return skyCol;}}
  return skyCol;
}
function smooth(a,b,x){var t=Math.max(0,Math.min(1,(x-a)/(b-a)));return t*t*(3-2*t);}
var hemiDay=CC('#ffffff'),hemiNight=CC('#7F8FC8'),gDay=CC('#9db98a'),gNight=CC('#27384A');
var sunWarm=CC('#FFB070'),sunWhite=CC('#FFF3DF'),moonCol=CC('#9DB4FF'),cloudDay=CC('#ffffff'),cloudNight=CC('#6F7EA0');
var lastClock=-1,clockEl=$('clock'),phaseEl=$('phase');
function updateDay(dt,t){
  dayT=(dayT+dt/DAY_SECONDS)%1;
  var a=dayT*Math.PI*2,sa=Math.sin(a),day=smooth(-.15,.35,sa),night=1-day;
  var col=skyAt(dayT);scene.background.copy(col);scene.fog.color.copy(col);water.material.color.copy(col);
  hemi.intensity=.32+.58*day;hemi.color.copy(hemiNight).lerp(hemiDay,day);hemi.groundColor.copy(gNight).lerp(gDay,day);
  var up=sa>=0,ap=up?a:a-Math.PI;
  sun.position.set(P.x+Math.cos(ap)*60,Math.max(Math.sin(ap)*60,14),P.z+24);
  sun.target.position.set(P.x,0,P.z);
  if(up){sun.intensity=.95*smooth(0,.5,sa);sun.color.copy(sunWarm).lerp(sunWhite,smooth(.05,.6,sa));}
  else{sun.intensity=.38*smooth(0,.5,-sa);sun.color.copy(moonCol);}
  cloudM.color.copy(cloudNight).lerp(cloudDay,day);cloudM.emissiveIntensity=.25*day;
  var wi=smooth(.1,.7,night)*1.1;for(var w=0;w<winMats.length;w++)winMats[w].emissiveIntensity=wi;
  var ln=smooth(.15,.8,night);
  for(var l=0;l<lamps.length;l++){lamps[l].gm.opacity=ln*.4;lamps[l].bm.color.setRGB(.67+.33*ln,.7+.18*ln,.73-.1*ln);}
  lantern.intensity=ln*1.1;
  ffMat.opacity=ln*.9;fireflies.visible=ln>.02;
  if(fireflies.visible){
    for(var i=0;i<ffN;i++){var b=ffBase[i];ffPos[i*3]=b[0]+Math.sin(t*.6+b[3])*1.8;ffPos[i*3+1]=b[1]+Math.sin(t*1.1+b[3]*2)*.6;ffPos[i*3+2]=b[2]+Math.cos(t*.5+b[3])*1.8;}
    ffGeo.attributes.position.needsUpdate=true;
  }
  var hh=(dayT*24+6)%24,key=Math.floor(hh*6);
  if(key!==lastClock){
    lastClock=key;var h2=Math.floor(key/6),m2=(key%6)*10;
    clockEl.textContent=(h2<10?'0':'')+h2+':'+(m2<10?'0':'')+m2;
    phaseEl.textContent=hh>=5&&hh<8?'Dawn':hh>=8&&hh<17?'Day':hh>=17&&hh<19.5?'Dusk':'Night';
  }
}

/* loop */
var clock=new T.Clock(),time=0,active=null,mapTick=0;
function step(dt){
  var ix=(keys.r?1:0)-(keys.l?1:0)+joy.x,iz=(keys.d?1:0)-(keys.u?1:0)+joy.z;
  var m=Math.hypot(ix,iz);if(m>1){ix/=m;iz/=m;m=1;}
  if(!running){ix=0;iz=0;m=0;}
  var wantSprint=(keys.s||sprintTouch)&&m>.1&&stamina>0;
  if(wantSprint&&!wasSprint)Snd.sprint();
  if(!wantSprint&&wasSprint&&stamina<=0)Snd.empty();
  wasSprint=wantSprint;
  var speed=(wantSprint?17:9.5)*m;
  if(wantSprint)stamina=Math.max(0,stamina-30*dt);else stamina=Math.min(100,stamina+14*dt);
  var tx=m?ix/m*speed:0,tz=m?iz/m*speed:0,k=1-Math.exp(-12*dt);
  P.vx+=(tx-P.vx)*k;P.vz+=(tz-P.vz)*k;
  P.x+=P.vx*dt;P.z+=P.vz*dt;
  for(var i=0;i<colliders.length;i++){
    var c=colliders[i],dx=P.x-c.x,dz=P.z-c.z,d=Math.hypot(dx,dz),min=c.r+.8;
    if(d<min&&d>.0001){P.x=c.x+dx/d*min;P.z=c.z+dz/d*min;}
  }
  var rd=Math.hypot(P.x,P.z);if(rd>57){P.x*=57/rd;P.z*=57/rd;}
  var sp=Math.hypot(P.vx,P.vz);
  if(sp>.4){var tr=Math.atan2(P.vx,P.vz),d2=((tr-P.rot+Math.PI)%(2*Math.PI)+2*Math.PI)%(2*Math.PI)-Math.PI;P.rot+=d2*Math.min(1,14*dt);}
  P.phase+=sp*dt*1.15;
  var si=Math.floor(P.phase/Math.PI);
  if(si!==lastStep){lastStep=si;if(sp>1.5&&running)Snd.step();}
  var sw=Math.min(1,sp/6);
  legL.rotation.x=Math.sin(P.phase)*.9*sw;legR.rotation.x=-Math.sin(P.phase)*.9*sw;
  armL.rotation.x=-Math.sin(P.phase)*.8*sw;armR.rotation.x=Math.sin(P.phase)*.8*sw;
  body.position.y=Math.abs(Math.sin(P.phase))*.18*sw;
  player.position.set(P.x,0,P.z);player.rotation.y=P.rot;
  stamBar.style.transform='scaleX('+(stamina/100)+')';
  /* coffee */
  for(var j=0;j<coffee.length;j++){
    var cf=coffee[j];if(cf.got)continue;
    if(Math.hypot(P.x-cf.x,P.z-cf.z)<2){
      Snd.coffee();cf.got=true;cf.g.visible=false;cf.glow.visible=false;coffeeCount++;coffeeN.textContent=coffeeCount;stamina=Math.min(100,stamina+40);
      toast(coffeeCount===TOTAL_COFFEE?'All '+TOTAL_COFFEE+' coffees collected':'Coffee '+coffeeCount+' of '+TOTAL_COFFEE+', stamina refilled');
    }
  }
  /* stops */
  var best=null,bd=1e9,all=STOPS.concat([MAIL]);
  for(var n=0;n<all.length;n++){var s=all[n],dd=Math.hypot(P.x-s.pos[0],P.z-s.pos[1]);if(dd<s.ir&&dd<bd){best=s;bd=dd;}}
  if(best!==active){active=best;if(running){showCard(best);if(best&&(best.visited||!best.counts))Snd.near();}}
  if(best&&best.counts&&!best.visited&&running)markVisited(best);
}
function frame(){
  requestAnimationFrame(frame);
  var dt=Math.min(clock.getDelta(),.05);time+=dt;
  step(dt);
  for(var i=0;i<anims.length;i++)anims[i](time,dt);
  var kc=1-Math.exp(-4*dt);
  camPos.x+=(P.x+camOff.x-camPos.x)*kc;camPos.y+=(camOff.y-camPos.y)*kc;camPos.z+=(P.z+camOff.z-camPos.z)*kc;
  camLook.x+=(P.x-camLook.x)*kc;camLook.z+=(P.z-camLook.z)*kc;
  camera.position.copy(camPos);camera.lookAt(camLook.x,1,camLook.z);
  updateDay(dt,time);
  renderer.render(scene,camera);
  if(++mapTick%2===0)drawMap();
}
frame();
}
})();
</script>

</body>
</html>
