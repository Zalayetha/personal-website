/* roads */
var roadMat=new T.MeshStandardMaterial({color:'#E3E0D8',roughness:1,flatShading:true,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2});
var segs=[];
ROADS.forEach(function(line){
  for(var i=0;i<line.length;i++){
    var p=line[i];
    var j=new T.Mesh(new T.CircleGeometry(1.7,14),roadMat);j.rotation.x=-Math.PI/2;j.position.set(p[0],.06,p[1]);j.receiveShadow=true;scene.add(j);
    if(i<line.length-1){
      var q=line[i+1],dx=q[0]-p[0],dz=q[1]-p[1],L=Math.hypot(dx,dz);
      var m=new T.Mesh(new T.PlaneGeometry(L,3.4),roadMat);
      m.rotation.order='YXZ';m.rotation.x=-Math.PI/2;m.rotation.y=-Math.atan2(dz,dx);
      m.position.set((p[0]+q[0])/2,.06,(p[1]+q[1])/2);m.receiveShadow=true;scene.add(m);
      segs.push([p[0],p[1],q[0],q[1]]);
    }
  }
});
function dseg(x,z,s){
  var ax=s[0],az=s[1],bx=s[2],bz=s[3],dx=bx-ax,dz=bz-az,t=((x-ax)*dx+(z-az)*dz)/(dx*dx+dz*dz);
  t=Math.max(0,Math.min(1,t));return Math.hypot(x-(ax+dx*t),z-(az+dz*t));
}
function nearRoad(x,z,w){for(var i=0;i<segs.length;i++){if(dseg(x,z,segs[i])<w)return true;}return false;}
function nearStop(x,z,m){
  for(var i=0;i<STOPS.length;i++){var s=STOPS[i];if(Math.hypot(x-s.pos[0],z-s.pos[1])<s.cr+m)return true;}
  if(Math.hypot(x-MAIL.pos[0],z-MAIL.pos[1])<m+2)return true;
  return Math.hypot(x,z)<12;
}

