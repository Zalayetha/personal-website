  for(var i=0;i<cols;i++)for(var j=0;j<rows;j++){var on=r()<.3;g.fillStyle=on?lit:glass;g.fillRect(i*32+7,j*32+6,18,19);if(on){eg.fillStyle='#fff';eg.fillRect(i*32+7,j*32+6,18,19);}}
