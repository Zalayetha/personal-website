---
import "../styles/styles.css";
import Favicon from "../components/layout/Favicon.astro";
import SEO from "../components/layout/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { contact } from "../data/portfolio";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

const services = [
    {
        title: "Web App MVP",
        description:
            "Turn your product idea into a focused first version ready for real users.",
        items: [
            "Core product workflow & architecture",
            "Responsive, accessible web interface",
            "Robust API & database integration",
            "Deployment-ready production build",
        ],
    },
    {
        title: "Landing Page & Web Presence",
        description:
            "Launch a clear, fast page that explains your product and converts visitors.",
        items: [
            "Product messaging & clear positioning",
            "Conversion-focused call to actions",
            "Fast performance & mobile-first design",
            "SEO & analytics configuration",
        ],
    },
];

const process = [
    {
        title: "Plan",
        description:
            "Clarify your product goal, target users, and smallest useful version to build.",
    },
    {
        title: "Build",
        description:
            "Design and develop the core experience with iterative progress and clear updates.",
    },
    {
        title: "Launch",
        description:
            "Prepare the product for release, review details, and deploy confidently.",
    },
];

const breadcrumbs = [
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
];
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <Favicon />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Services | Zaghy Zalayetha</title>
        <meta
            name="description"
            content="Web app MVP development and high-converting landing pages built by Zaghy Zalayetha."
        />
        <SEO
            title="Services | Zaghy Zalayetha"
            description="Web app MVP development and high-converting landing pages built by Zaghy Zalayetha."
            breadcrumbs={breadcrumbs}
        />
    </head>
    <body class="min-h-screen flex flex-col bg-white text-[#1e293b] font-sans antialiased selection:bg-[#d4f4e2] selection:text-[#008752]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12 space-y-12 sm:space-y-16">
            <header class="border-b border-[#e2e8f0] pb-8 sm:pb-10">
                <span class="eyebrow block mb-3 text-[#64748b]">Offering</span>
                <h1 class="text-[clamp(34px,4.5vw,48px)] font-bold tracking-[-0.05em] text-[#0f172a] leading-[1.1] m-0">
                    Services<span class="text-[#008752]">.</span>
                </h1>
                <p class="max-w-[560px] text-[15px] sm:text-[16px] text-[#64748b] leading-[1.8] mt-4">
                    I help founders and teams turn ideas into useful, performant web and mobile products from first direction to production launch.
                </p>
            </header>

            <div class="grid md:grid-cols-2 gap-8">
                {
                    services.map((service) => (
                        <div class="border-t border-[#e2e8f0] pt-6 flex flex-col justify-between">
                            <div>
                                <h2 class="text-[20px] font-semibold tracking-[-0.03em] text-[#0f172a] mb-3">
                                    {service.title}
                                </h2>
                                <p class="text-[14px] text-[#64748b] leading-[1.7] mb-6">
                                    {service.description}
                                </p>
                            </div>
                            <ul class="space-y-2.5 pt-4 border-t border-[#e2e8f0]">
                                {service.items.map((item) => (
                                    <li class="flex items-center gap-3 text-[13px] text-[#1e293b]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#008752] shrink-0" />
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>

            <!-- Process -->
            <div class="border-t border-[#e2e8f0] pt-12">
                <span class="eyebrow block mb-1 text-[#64748b]">Workflow</span>
                <h2 class="text-[23px] font-semibold tracking-[-0.035em] text-[#0f172a] mb-8">
                    How we collaborate<span class="text-[#008752]">.</span>
                </h2>

                <div class="grid md:grid-cols-3 gap-8">
                    {
                        process.map((step, idx) => (
                            <div class="border-t border-[#e2e8f0] pt-4">
                                <span class="font-mono text-xs text-[#008752] font-semibold block mb-2">
                                    0{idx + 1}
                                </span>
                                <h3 class="text-[16px] font-semibold text-[#0f172a] mb-2">
                                    {step.title}
                                </h3>
                                <p class="text-[13px] text-[#64748b] leading-[1.7]">
                                    {step.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Contact -->
            <div id="contact" class="border-t border-[#e2e8f0] pt-12 pb-6 max-w-[560px]">
                <span class="eyebrow block mb-1 text-[#64748b]">Contact</span>
                <h2 class="text-[23px] font-semibold tracking-[-0.035em] text-[#0f172a] mb-2">
                    Have a project in mind?
                </h2>
                <p class="text-[14px] text-[#64748b] leading-[1.7] mb-6">
                    Send a short message and I'll reply by email.
                </p>
                <form id="contact-form" method="post" action="/api/contact" class="space-y-4" novalidate>
                    <div class="hidden" aria-hidden="true">
                        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
                    </div>
                    <div>
                        <label for="cf-name" class="block text-[13px] font-medium text-[#0f172a] mb-1">Name</label>
                        <input id="cf-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" class="w-full border border-[#e2e8f0] rounded-md px-3 py-2 text-[14px] focus:outline-none focus:border-[#008752]" />
                    </div>
                    <div>
                        <label for="cf-email" class="block text-[13px] font-medium text-[#0f172a] mb-1">Email</label>
                        <input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email" class="w-full border border-[#e2e8f0] rounded-md px-3 py-2 text-[14px] focus:outline-none focus:border-[#008752]" />
                    </div>
                    <div>
                        <label for="cf-message" class="block text-[13px] font-medium text-[#0f172a] mb-1">Message</label>
                        <textarea id="cf-message" name="message" required minlength="10" maxlength="5000" rows="5" class="w-full border border-[#e2e8f0] rounded-md px-3 py-2 text-[14px] focus:outline-none focus:border-[#008752]"></textarea>
                    </div>
                    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
                    <button type="submit" class="bg-[#008752] hover:bg-[#007346] text-white text-sm font-semibold rounded-md px-5 py-2.5 disabled:opacity-60">
                        Send message
                    </button>
                    <p id="contact-status" role="status" aria-live="polite" class="text-[13px] min-h-[1.25rem]"></p>
                </form>
                <p class="text-[13px] text-[#64748b] mt-4">
                    Prefer email?
                    <a href={`mailto:${contact.email}`} class="text-link text-[#008752] hover:text-[#007346] font-semibold">
                        <span>{contact.email}</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                </p>
            </div>
            {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
            <script>
                const form = document.getElementById("contact-form") as HTMLFormElement | null;
                const status = document.getElementById("contact-status");
                form?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    if (!status) return;
                    if (!form.checkValidity()) {
                        status.className = "text-[13px] text-red-600";
                        status.textContent = "Please fill in all fields with valid values.";
                        form.reportValidity();
                        return;
                    }
                    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
                    btn.disabled = true;
                    status.className = "text-[13px] text-[#64748b]";
                    status.textContent = "Sending…";
                    try {
                        const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) throw new Error(data.error || "Something went wrong.");
                        form.reset();
                        status.className = "text-[13px] text-[#008752]";
                        status.textContent = "Thanks! Your message was sent.";
                    } catch (err) {
                        status.className = "text-[13px] text-red-600";
                        status.textContent = (err instanceof Error ? err.message : "Something went wrong.") + " You can also email me directly.";
                    } finally {
                        btn.disabled = false;
                    }
                });
            </script>
        </main>
        <Footer />
    </body>
</html>
