---
import "../styles/styles.css";

import Favicon from "../components/layout/Favicon.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import HomeHero from "../components/sections/home/Hero.astro";
import Projects from "../components/sections/Projects.astro";
import Blog from "../components/sections/home/Blog.astro";
import ExperienceSection from "../components/sections/home/ExperienceSection.astro";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <Favicon />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Zaghy Zalayetha | Software Engineer</title>
        <meta
            name="description"
            content="Zaghy Zalayetha. Software Engineer based in Indonesia."
        />
    </head>
    <body class="min-h-screen flex flex-col bg-white text-[#1e293b] font-sans antialiased selection:bg-[#d4f4e2] selection:text-[#008752]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full">
            <HomeHero />
            <Projects />
            <Blog />
            <ExperienceSection />
        </main>
        <Footer />
    </body>
</html>
