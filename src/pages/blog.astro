---
import "../styles/styles.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Section from "../components/layout/Section.astro";
import { blogPosts } from "../data/portfolio";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/sprout.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Blog - Zaghy Zalayetha</title>
    </head>
    <body>
        <Header />
        <main>
            <Section id="blog">
                <div class="max-w-5xl mx-auto">
                    <div class="text-center mb-16">
                        <h1
                            class="font-newsreader text-4xl lg:text-5xl font-bold text-gray-950 mb-4"
                        >
                            Blog
                        </h1>
                        <p
                            class="font-manrope text-base text-gray-500 max-w-xl mx-auto"
                        >
                            Thoughts on building software and everything in
                            between.
                        </p>
                    </div>

                    <div class="grid lg:grid-cols-2 gap-6">
                        {
                            blogPosts.map((post) => (
                                <a
                                    href={`/blog/${post.slug}`}
                                    class="group block p-6 rounded-2xl bg-white border border-gray-200 transition-all duration-300 hover:border-gray-300 hover:shadow-lg hover:shadow-gray-200/50"
                                >
                                    <div class="flex items-center gap-2 mb-3">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="16"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="w-4 h-4 text-gray-400"
                                        >
                                            <>
                                                <rect
                                                    width="18"
                                                    height="18"
                                                    x="3"
                                                    y="4"
                                                    rx="2"
                                                    ry="2"
                                                />
                                                <line
                                                    x1="16"
                                                    x2="16"
                                                    y1="2"
                                                    y2="6"
                                                />
                                                <line
                                                    x1="8"
                                                    x2="8"
                                                    y1="2"
                                                    y2="6"
                                                />
                                                <line
                                                    x1="3"
                                                    x2="21"
                                                    y1="10"
                                                    y2="10"
                                                />
                                            </>
                                        </svg>
                                        <span class="font-manrope text-sm text-gray-400">
                                            {post.date}
                                        </span>
                                    </div>
                                    <h2 class="font-newsreader text-xl font-semibold text-gray-950 mb-2 group-hover:text-gray-700 transition-colors">
                                        {post.title}
                                    </h2>
                                    <p class="font-manrope text-sm text-gray-500 leading-relaxed mb-4">
                                        {post.excerpt}
                                    </p>
                                    <div class="flex flex-wrap gap-2 mb-4">
                                        {post.tags.map((tag) => (
                                            <span class="font-manrope text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-500">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                    <span class="font-manrope text-sm font-medium text-gray-400 transition-colors duration-300 group-hover:text-gray-700">
                                        Read more →
                                    </span>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </Section>
        </main>
        <Footer />
    </body>
</html>
