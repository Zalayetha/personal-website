---
import "../styles/styles.css";
import Favicon from "../components/layout/Favicon.astro";
import SEO from "../components/layout/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { blogPosts } from "../data/portfolio";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <Favicon />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Writing | Zaghy Zalayetha</title>
        <meta
            name="description"
            content="Thoughts on software engineering, mobile development, product architecture, and learnings by Zaghy Zalayetha."
        />
        <SEO
            title="Writing | Zaghy Zalayetha"
            description="Thoughts on software engineering, mobile development, product architecture, and learnings by Zaghy Zalayetha."
        />
    </head>
    <body class="min-h-screen flex flex-col bg-white text-[#1e293b] font-sans antialiased selection:bg-[#d4f4e2] selection:text-[#008752]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12">
            <header class="border-b border-[#e2e8f0] pb-8 sm:pb-10 mb-8 sm:mb-12">
                <span class="eyebrow block mb-3 text-[#64748b]">Articles &amp; Notes</span>
                <h1 class="text-[clamp(34px,4.5vw,48px)] font-bold tracking-[-0.05em] text-[#0f172a] leading-[1.1] m-0">
                    Writing<span class="text-[#008752]">.</span>
                </h1>
                <p class="max-w-[560px] text-[15px] sm:text-[16px] text-[#64748b] leading-[1.8] mt-4">
                    Reflections on mobile apps, software architecture, developer experience, and lessons learned along the way.
                </p>
            </header>

            <div class="flex flex-col border-t border-[#e2e8f0]">
                {
                    blogPosts.map((post) => (
                        <article class="border-b border-[#e2e8f0] py-7 sm:py-9">
                            <a
                                href={`/blog/${post.slug}`}
                                class="group block no-underline"
                            >
                                <div class="flex items-baseline justify-between gap-4">
                                    <h2 class="text-[17px] sm:text-[19px] font-semibold tracking-[-0.025em] text-[#0f172a] m-0 group-hover:text-[#008752] group-hover:underline underline-offset-4 decoration-1">
                                        {post.title}
                                    </h2>
                                    <span class="link-arrow text-sm text-[#64748b] group-hover:text-[#008752] hidden sm:inline-block" aria-hidden="true">
                                        ↗
                                    </span>
                                </div>

                                <p class="text-[14px] text-[#64748b] leading-[1.7] mt-2 mb-3 max-w-2xl">
                                    {post.excerpt}
                                </p>

                                <div class="flex items-center gap-4 text-xs">
                                    <time class="text-[#64748b] font-mono text-[11px]">
                                        {post.date}
                                    </time>
                                    <span class="text-[#e2e8f0]">&middot;</span>
                                    <div class="flex items-center gap-2">
                                        {post.tags.slice(0, 2).map((tag) => (
                                            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#e8f8f0] text-[#008752] border border-[#008752]/20 font-medium">
                                                #{tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </main>
        <Footer />
    </body>
</html>
