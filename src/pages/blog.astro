---
import "../styles/styles.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { blogPosts } from "../data/portfolio";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/sprout.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Writing | Zaghy Zalayetha</title>
        <meta
            name="description"
            content="Thoughts on software engineering, mobile development, product architecture, and learnings by Zaghy Zalayetha."
        />
    </head>
    <body class="min-h-screen flex flex-col bg-[#f4f4ee] text-[#42443f] font-sans antialiased selection:bg-[#d5d6cf] selection:text-[#151614]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12">
            <header class="border-b border-[#d1d3ca] pb-8 sm:pb-10 mb-8 sm:mb-12">
                <span class="eyebrow block mb-3">Articles &amp; Notes</span>
                <h1 class="text-[clamp(34px,4.5vw,48px)] font-normal tracking-[-0.05em] text-[#151614] leading-[1.1] m-0">
                    Writing<span class="text-[#888985]">.</span>
                </h1>
                <p class="max-w-[560px] text-[15px] sm:text-[16px] text-[#676a62] leading-[1.8] mt-4">
                    Reflections on mobile apps, software architecture, developer experience, and lessons learned along the way.
                </p>
            </header>

            <div class="flex flex-col border-t border-[#d1d3ca]">
                {
                    blogPosts.map((post) => (
                        <article class="border-b border-[#d1d3ca] py-7 sm:py-9">
                            <a
                                href={`/blog/${post.slug}`}
                                class="group block no-underline"
                            >
                                <div class="flex items-baseline justify-between gap-4">
                                    <h2 class="text-[17px] sm:text-[19px] font-medium tracking-[-0.025em] text-[#151614] m-0 group-hover:underline underline-offset-4 decoration-1">
                                        {post.title}
                                    </h2>
                                    <span class="link-arrow text-sm hidden sm:inline-block" aria-hidden="true">
                                        ↗
                                    </span>
                                </div>

                                <p class="text-[14px] text-[#676a62] leading-[1.7] mt-2 mb-3 max-w-2xl">
                                    {post.excerpt}
                                </p>

                                <div class="flex items-center gap-4 text-xs">
                                    <time class="text-[#676a62] font-mono text-[11px]">
                                        {post.date}
                                    </time>
                                    <span class="text-[#d1d3ca]">&middot;</span>
                                    <div class="flex items-center gap-2">
                                        {post.tags.slice(0, 2).map((tag) => (
                                            <span class="text-[11px] font-mono text-[#676a62]">
                                                #{tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </main>
        <Footer />
    </body>
</html>
