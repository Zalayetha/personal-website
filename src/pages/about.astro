---
import "../styles/styles.css";
import Favicon from "../components/layout/Favicon.astro";
import SEO from "../components/layout/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { experience, education, skillGroups, publication } from "../data/portfolio";

const breadcrumbs = [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
];
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <Favicon />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>About | Zaghy Zalayetha</title>
        <meta
            name="description"
            content="Learn more about Zaghy Zalayetha, Software Engineer based in Indonesia. Background, experience, education, and technical skills."
        />
        <SEO
            title="About | Zaghy Zalayetha"
            description="Learn more about Zaghy Zalayetha, Software Engineer based in Indonesia. Background, experience, education, and technical skills."
            breadcrumbs={breadcrumbs}
        />
    </head>
    <body class="min-h-screen flex flex-col bg-white text-[#1e293b] font-sans antialiased selection:bg-[#d4f4e2] selection:text-[#008752]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12">
            <!-- Intro / Bio -->
            <header class="border-b border-[#e2e8f0] pb-10 sm:pb-12 mb-10 sm:mb-12">
                <span class="eyebrow block mb-3 text-[#64748b]">Background</span>
                <h1 class="text-[clamp(34px,4.5vw,48px)] font-bold tracking-[-0.05em] text-[#0f172a] leading-[1.1] m-0">
                    A little about me<span class="text-[#008752]">.</span>
                </h1>

                <div class="grid grid-cols-1 md:grid-cols-[1.2fr_0.8fr] gap-8 mt-6 items-start">
                    <div class="space-y-4 text-[15px] sm:text-[16px] text-[#1e293b] leading-[1.85]">
                        <p>
                            I'm <strong class="text-[#0f172a] font-semibold">Zaghy Zalayetha</strong>, a Software Engineer based in Tangerang, Indonesia. I build web applications, cross-platform mobile apps, and backend services that solve real operational needs.
                        </p>
                        <p class="text-[#64748b]">
                            Graduated in Informatics Engineering from Universitas Budi Luhur. Currently building scalable full-stack web platforms at <strong class="text-[#0f172a] font-semibold">C3ARBON</strong>.
                        </p>
                        <p class="text-[#64748b]">
                            I enjoy the entire product loop: understanding user workflows, architecting clean codebases, optimizing performance, and delivering polished, accessible software.
                        </p>
                    </div>

                    <div class="flex justify-start md:justify-end">
                        <div class="w-48 h-48 sm:w-56 sm:h-56 rounded-2xl overflow-hidden border border-[#e2e8f0] bg-[#f8fafc] shadow-xs">
                            <img
                                src="/assets/profile_picture.png"
                                alt="Zaghy Zalayetha - Software Engineer"
                                width="224"
                                height="224"
                                class="w-full h-full object-cover grayscale contrast-[1.05]"
                                loading="eager"
                                decoding="async"
                            />
                        </div>
                    </div>
                </div>
            </header>

            <!-- Experience Timeline -->
            <section class="border-b border-[#e2e8f0] pb-12 sm:pb-16 mb-12 sm:mb-16">
                <div class="mb-6">
                    <span class="eyebrow block mb-1 text-[#64748b]">Career</span>
                    <h2 class="text-[23px] font-semibold tracking-[-0.035em] text-[#0f172a] m-0">
                        Along the way<span class="text-[#008752]">.</span>
                    </h2>
                </div>

                <div class="flex flex-col border-t border-[#e2e8f0]">
                    {
                        experience.map((item) => (
                            <div class="border-b border-[#e2e8f0] py-6 sm:py-8">
                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                                    <div>
                                        <h3 class="text-[16px] sm:text-[17px] font-semibold text-[#0f172a] m-0">
                                            {item.company}
                                        </h3>
                                        <p class="text-[13px] text-[#64748b] mt-0.5 mb-0">
                                            {item.roles ? (
                                                <span class="font-mono text-[11px]">{item.location}</span>
                                            ) : (
                                                <>
                                                    {item.role} &middot; <span class="font-mono text-[11px]">{item.location}</span>
                                                </>
                                            )}
                                        </p>
                                    </div>
                                    <span class="text-[#64748b] font-mono text-[11px] flex-shrink-0">
                                        {item.period}
                                    </span>
                                </div>

                                {item.roles ? (
                                    <div class="space-y-6 pl-4 border-l-2 border-[#e2e8f0] ml-1 mt-5">
                                        {item.roles.map((role) => (
                                            <div>
                                                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
                                                    <h4 class="text-[14px] sm:text-[15px] font-semibold text-[#0f172a] m-0">
                                                        {role.title}
                                                    </h4>
                                                    <span class="text-[#64748b] font-mono text-[10px] sm:text-[11px]">
                                                        {role.period}
                                                    </span>
                                                </div>

                                                {role.description && (
                                                    <p class="text-[13px] text-[#1e293b] leading-[1.7] my-2 max-w-2xl">
                                                        {role.description}
                                                    </p>
                                                )}

                                                {role.skills && (
                                                    <div class="flex flex-wrap items-center gap-1.5 mt-2">
                                                        {role.skills.map((skill) => (
                                                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#e8f8f0] text-[#008752] border border-[#008752]/20 font-medium">
                                                                {skill}
                                                            </span>
                                                        ))}
                                                    </div>
                                                )}
                                            </div>
                                        ))}
                                    </div>
                                ) : (
                                    <>
                                        {item.description && (
                                            <p class="text-[13px] text-[#1e293b] leading-[1.7] mt-3 mb-2 max-w-2xl">
                                                {item.description}
                                            </p>
                                        )}

                                        {item.skills && (
                                            <div class="flex flex-wrap items-center gap-1.5 mt-3">
                                                {item.skills.map((skill) => (
                                                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#e8f8f0] text-[#008752] border border-[#008752]/20 font-medium">
                                                        {skill}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                    </>
                                )}
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Education & Research -->
            <section class="border-b border-[#e2e8f0] pb-12 sm:pb-16 mb-12 sm:mb-16">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div>
                        <span class="eyebrow block mb-1 text-[#64748b]">Academics</span>
                        <h2 class="text-[21px] font-semibold tracking-[-0.035em] text-[#0f172a] mb-4">
                            Education<span class="text-[#008752]">.</span>
                        </h2>

                        <div class="space-y-6">
                            {
                                education.map((edu) => (
                                    <div class="border-t border-[#e2e8f0] pt-4">
                                        <h3 class="text-[15px] font-semibold text-[#0f172a] m-0">
                                            {edu.institution}
                                        </h3>
                                        <p class="text-[13px] text-[#1e293b] mt-1 mb-0.5">
                                            {edu.degree}
                                        </p>
                                        <p class="text-[11px] font-mono text-[#64748b] m-0">
                                            {edu.period}
                                        </p>
                                        {edu.achievement && (
                                            <span class="inline-block mt-2 text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#e8f8f0] text-[#008752] border border-[#008752]/20 font-medium">
                                                ★ {edu.achievement}
                                            </span>
                                        )}
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <div>
                        <span class="eyebrow block mb-1 text-[#64748b]">Publications</span>
                        <h2 class="text-[21px] font-semibold tracking-[-0.035em] text-[#0f172a] mb-4">
                            Research<span class="text-[#008752]">.</span>
                        </h2>

                        <div class="border-t border-[#e2e8f0] pt-4">
                            <h3 class="text-[14px] font-semibold text-[#0f172a] leading-[1.5] m-0">
                                {publication.title}
                            </h3>
                            <p class="text-[12px] text-[#64748b] mt-1.5 mb-1 font-mono">
                                {publication.authors}
                            </p>
                            <p class="text-[11px] text-[#64748b] leading-[1.6] mb-3">
                                {publication.venue}
                            </p>
                            <a
                                href={publication.url}
                                target="_blank"
                                rel="noreferrer"
                                class="text-link text-xs text-[#008752] hover:underline font-medium"
                            >
                                <span>Read publication</span>
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Skill Groups -->
            <section class="pb-12 sm:pb-16">
                <span class="eyebrow block mb-1 text-[#64748b]">Toolkit</span>
                <h2 class="text-[23px] font-semibold tracking-[-0.035em] text-[#0f172a] mb-6">
                    Skills &amp; capabilities<span class="text-[#008752]">.</span>
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    {
                        skillGroups.map((group) => (
                            <div class="border-t border-[#e2e8f0] pt-4">
                                <h3 class="text-[12px] font-semibold text-[#0f172a] uppercase tracking-wider font-mono mb-3">
                                    {group.title}
                                </h3>
                                <ul class="m-0 p-0 list-none space-y-1.5">
                                    {group.skills.map((skill) => (
                                        <li class="text-[13px] text-[#1e293b] m-0 p-0">
                                            {skill}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </section>
        </main>
        <Footer />
    </body>
</html>
