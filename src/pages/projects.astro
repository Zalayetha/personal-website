---
import { SITE_URL } from "../utils/seo";

const target = "/work";
const siteUrl = Astro.site ? Astro.site.origin : SITE_URL;
const canonicalURL = new URL(target, siteUrl).toString();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0;url=${target}`} />
        <link rel="canonical" href={canonicalURL} />
        <meta name="robots" content="noindex, follow" />
        <title>Redirecting to /work...</title>
    </head>
    <body>
        <p>Redirecting to <a href={target}>/work</a>...</p>
    </body>
</html>
