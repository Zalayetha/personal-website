---
import "../styles/styles.css";
import Favicon from "../components/layout/Favicon.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { projects } from "../data/portfolio";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <Favicon />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Work | Zaghy Zalayetha</title>
        <meta
            name="description"
            content="Production mobile apps, full-stack web platforms, and engineering experiments built by Zaghy Zalayetha."
        />
    </head>
    <body class="min-h-screen flex flex-col bg-[#f4f4ee] text-[#42443f] font-sans antialiased selection:bg-[#d5d6cf] selection:text-[#151614]">
        <Header />
        <main class="page-shell flex-1 flex flex-col w-full pt-8 sm:pt-12">
            <header class="border-b border-[#d1d3ca] pb-8 sm:pb-10 mb-8 sm:mb-12">
                <span class="eyebrow block mb-3">Portfolio</span>
                <h1 class="text-[clamp(34px,4.5vw,48px)] font-normal tracking-[-0.05em] text-[#151614] leading-[1.1] m-0">
                    Work<span class="text-[#888985]">.</span>
                </h1>
                <p class="max-w-[560px] text-[15px] sm:text-[16px] text-[#676a62] leading-[1.8] mt-4">
                    Production mobile apps, full-stack platforms, and engineering experiments. A collection of systems I've helped build and ship.
                </p>
            </header>

            <div class="flex flex-col border-t border-[#d1d3ca]">
                {
                    projects.map((project) => (
                        <article class="border-b border-[#d1d3ca] py-8 sm:py-10">
                            <a
                                href={`/projects/${project.slug}`}
                                class="group block no-underline"
                            >
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1">
                                        <div class="flex flex-wrap items-center gap-3">
                                            <h2 class="text-[19px] sm:text-[21px] font-medium tracking-[-0.03em] text-[#151614] m-0 group-hover:underline underline-offset-4 decoration-1">
                                                {project.title}
                                            </h2>
                                        </div>

                                        <p class="text-[14px] sm:text-[15px] text-[#676a62] leading-[1.7] mt-2 mb-4 max-w-2xl">
                                            {project.tagline}
                                        </p>

                                        <div class="flex flex-wrap items-center gap-2 pt-1">
                                            {project.techStack.map((tech) => (
                                                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#eaeae3] text-[#42443f] border border-[#d1d3ca]/60">
                                                    {tech}
                                                </span>
                                            ))}
                                        </div>
                                    </div>

                                    <span class="link-arrow text-base text-[#676a62] pt-1" aria-hidden="true">
                                        ↗
                                    </span>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </main>
        <Footer />
    </body>
</html>
