---
import "../styles/styles.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Section from "../components/layout/Section.astro";
import { MagicCard } from "../components/magicui/magic-card";
import { GridPattern } from "../components/magicui/grid-pattern";
import { BlurFade } from "../components/magicui/blur-fade";
import { projects } from "../data/portfolio";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/sprout.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Projects - Zaghy Zalayetha</title>
    </head>
    <body class="relative overflow-x-hidden">
        <Header />
        <main class="relative">
            <!-- Magic UI Grid Background -->
            <GridPattern
                client:visible
                width={36}
                height={36}
                className="[mask-image:radial-gradient(ellipse_60%_50%_at_50%_25%,#000_70%,transparent_100%)] opacity-30"
            />

            <Section id="projects">
                <div class="relative z-10 max-w-5xl mx-auto">
                    <BlurFade client:visible delay={0.05}>
                        <div class="text-center mb-16">
                            <h1
                                class="font-newsreader text-4xl lg:text-5xl font-bold text-gray-950 mb-4"
                            >
                                Projects
                            </h1>
                            <p
                                class="font-manrope text-base text-gray-500 max-w-xl mx-auto"
                            >
                                A collection of things I've built and shipped.
                            </p>
                        </div>
                    </BlurFade>

                    <div class="grid lg:grid-cols-2 gap-6">
                        {
                            projects.map((project, idx) => (
                                <BlurFade client:visible delay={0.1 + idx * 0.08}>
                                    <a
                                        href={`/projects/${project.slug}`}
                                        class="block h-full group"
                                    >
                                        <MagicCard
                                            client:visible
                                            gradientSize={280}
                                            gradientColor="rgba(55, 65, 81, 0.14)"
                                            className="p-6 h-full flex flex-col justify-between transition-all duration-300 hover:border-gray-400/80 hover:shadow-xl hover:shadow-gray-200/60"
                                        >
                                            <div>
                                                <div class="flex items-start justify-between mb-4">
                                                    <div class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center overflow-hidden border border-gray-200/60">
                                                        {project.image ? (
                                                            <img
                                                                src={project.image}
                                                                alt={`${project.title} icon`}
                                                                class="w-8 h-8 object-contain"
                                                            />
                                                        ) : (
                                                            <span class="font-newsreader text-xl font-bold text-gray-600">
                                                                {project.title.charAt(0)}
                                                            </span>
                                                        )}
                                                    </div>
                                                    <div class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center border border-gray-200/60 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            width="16"
                                                            height="16"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            class="text-gray-400 group-hover:text-gray-950 transition-colors"
                                                        >
                                                            <path d="M7 7h10v10" />
                                                            <path d="M7 17 17 7" />
                                                        </svg>
                                                    </div>
                                                </div>
                                                <h2 class="font-newsreader text-xl font-semibold text-gray-950 mb-2">
                                                    {project.title}
                                                </h2>
                                                <p class="font-manrope text-sm text-gray-500 leading-relaxed mb-4">
                                                    {project.tagline}
                                                </p>
                                            </div>
                                            <span class="font-manrope text-sm font-medium text-gray-400 transition-colors duration-300 group-hover:text-gray-950">
                                                View Project →
                                            </span>
                                        </MagicCard>
                                    </a>
                                </BlurFade>
                            ))
                        }
                    </div>
                </div>
            </Section>
        </main>
        <Footer />
    </body>
</html>
